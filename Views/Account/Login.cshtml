@model hrms.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - HRMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-navy: #1e3a5f;
            --primary-charcoal: #2c3e50;
            --accent-blue: #3498db;
            --accent-teal: #16a085;
            --light-gray: #f8f9fa;
            --border-light: #e9ecef;
            --shadow-heavy: 0 20px 60px rgba(0, 0, 0, 0.15);
            --border-radius-lg: 16px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            font-size: 14px;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        /* Large screen font size */
        @@media (min-width: 768px) {
            html {
                font-size: 16px;
            }
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, var(--primary-navy) 0%, var(--primary-charcoal) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="rgba(255,255,255,0.1)"/><circle cx="80" cy="40" r="1" fill="rgba(255,255,255,0.08)"/><circle cx="40" cy="80" r="1.5" fill="rgba(255,255,255,0.1)"/><circle cx="90" cy="80" r="1" fill="rgba(255,255,255,0.06)"/><circle cx="10" cy="60" r="1" fill="rgba(255,255,255,0.08)"/></svg>');
            animation: float-animation 20s infinite linear;
        }

        /* Float animation for background */
        @@-webkit-keyframes float-animation {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }

        @@keyframes float-animation {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }

        .login-container {
            max-width: 480px;
            width: 100%;
            position: relative;
            z-index: 1;
        }

        .login-card {
            background: white;
            border-radius: var(--border-radius-lg);
            box-shadow: var(--shadow-heavy);
            overflow: hidden;
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .login-header {
            background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.9) 100%);
            padding: 40px 40px 30px;
            text-align: center;
            border-bottom: 1px solid var(--border-light);
        }

        .brand-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            margin-bottom: 16px;
        }

        .brand-icon {
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal));
            border-radius: 12px;
            width: 56px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 20px rgba(52, 152, 219, 0.3);
        }

        .brand-icon i {
            font-size: 1.75rem;
            color: white;
        }

        .brand-text h2 {
            color: var(--primary-charcoal);
            font-weight: 700;
            font-size: 2rem;
            margin: 0;
        }

        .brand-subtitle {
            color: var(--accent-blue);
            font-weight: 500;
            font-size: 0.95rem;
            margin: 0;
        }

        .login-body {
            padding: 40px;
            background: white;
        }

        .welcome-text {
            text-align: center;
            margin-bottom: 32px;
        }

        .welcome-text h4 {
            color: var(--primary-charcoal);
            font-weight: 600;
            margin-bottom: 8px;
        }

        .welcome-text p {
            color: #6c757d;
            margin: 0;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            font-weight: 500;
            color: var(--primary-charcoal);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-control {
            border: 2px solid var(--border-light);
            border-radius: 12px;
            padding: 16px 20px;
            font-size: 1rem;
            transition: var(--transition);
            background: var(--light-gray);
        }

        .form-control:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 4px rgba(52, 152, 219, 0.1);
            background: white;
        }

        .form-check {
            margin: 24px 0;
        }

        .form-check-input {
            border-radius: 6px;
            border: 2px solid var(--border-light);
        }

        .form-check-input:checked {
            background-color: var(--accent-blue);
            border-color: var(--accent-blue);
        }

        .form-check-label {
            color: #6c757d;
            font-weight: 500;
        }

        .btn-login {
            width: 100%;
            padding: 16px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal));
            border: none;
            color: white;
            transition: var(--transition);
            box-shadow: 0 4px 20px rgba(52, 152, 219, 0.3);
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(52, 152, 219, 0.4);
            background: linear-gradient(135deg, var(--accent-teal), var(--accent-blue));
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .help-text {
            text-align: center;
            margin-top: 24px;
            padding: 16px;
            background: var(--light-gray);
            border-radius: 8px;
        }

        .help-text small {
            color: #6c757d;
            font-weight: 500;
        }

        .footer-text {
            text-align: center;
            margin-top: 24px;
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.875rem;
        }

        .alert {
            border: none;
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 24px;
            font-weight: 500;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border-left: 4px solid #dc3545;
        }

        /* Mobile responsiveness */
        @@media (max-width: 576px) {
            body {
                padding: 16px;
            }
            
            .login-header {
                padding: 32px 24px 24px;
            }
            
            .login-body {
                padding: 32px 24px;
            }
            
            .brand-container {
                flex-direction: column;
                gap: 12px;
            }
            
            .brand-text h2 {
                font-size: 1.75rem;
            }
        }

        /* Loading animation */
        .loading {
            opacity: 0.7;
            pointer-events: none;
        }

        .loading .btn-login {
            position: relative;
        }

        .loading .btn-login::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top: 2px solid white;
            border-radius: 50%;
            animation: spin-animation 1s linear infinite;
        }

        @@keyframes spin-animation {
            0% { transform: translate(-50%, -50%) rotate(0deg); }
            100% { transform: translate(-50%, -50%) rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="brand-container">
                    <div class="brand-icon">
                        <i class="bi bi-building-check"></i>
                    </div>
                    <div class="brand-text">
                        <h2>HRMS</h2>
                        <p class="brand-subtitle">Human Resource Management</p>
                    </div>
                </div>
            </div>
            
            <div class="login-body">
                <div class="welcome-text">
                    <h4>Welcome Back</h4>
                    <p>Sign in to access your account</p>
                </div>
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form asp-action="Login" method="post" id="loginForm">
                    <div class="form-group">
                        <label asp-for="LoginId" class="form-label">
                            <i class="bi bi-person"></i> Login ID
                        </label>
                        <input asp-for="LoginId" class="form-control" placeholder="Enter your login ID" autocomplete="username" />
                        <span asp-validation-for="LoginId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label">
                            <i class="bi bi-lock"></i> Password
                        </label>
                        <input asp-for="Password" class="form-control" placeholder="Enter your password" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">
                            Remember me for 30 days
                        </label>
                    </div>

                    <button type="submit" class="btn btn-login" id="loginBtn">
                        <span class="btn-text">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                        </span>
                    </button>
                </form>

                <div class="help-text">
                    <small>
                        <i class="bi bi-info-circle me-1"></i>
                        Need help? Contact your HR administrator for login credentials.
                    </small>
                </div>
            </div>
        </div>
        
        <div class="footer-text">
            <small>&copy; 2024 HRMS - Human Resource Management System</small>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Add loading state to form submission
            $('#loginForm').on('submit', function() {
                const form = $(this);
                const btn = $('#loginBtn');
                
                if (form.valid()) {
                    form.addClass('loading');
                    btn.find('.btn-text').text('Signing in...');
                }
            });
            
            // Add focus animations
            $('.form-control').on('focus', function() {
                $(this).parent().addClass('focused');
            }).on('blur', function() {
                $(this).parent().removeClass('focused');
            });
            
            // Animate elements on page load
            setTimeout(function() {
                $('.login-card').addClass('animate');
            }, 100);
        });
    </script>
</body>
</html>
