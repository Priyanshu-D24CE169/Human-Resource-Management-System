@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow">
            <div class="card-body p-5">
                <i class="bi bi-shield-exclamation text-danger" style="font-size: 5rem;"></i>
                <h2 class="mt-3">Access Denied</h2>
                <p class="text-muted">You don't have permission to access this resource.</p>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-3">
                    <i class="bi bi-house"></i> Go to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
