@model hrms.ViewModels.AttendanceReportViewModel
@{
    ViewData["Title"] = "Attendance Report";
}

<div class="row mb-4">
    <div class="col">
        <h2><i class="bi bi-file-earmark-bar-graph"></i> Attendance Report</h2>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <form asp-action="Report" method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Employee</label>
                <select name="employeeId" class="form-select">
                    <option value="">All Employees</option>
                    @foreach (var emp in Model.Employees)
                    {
                        <option value="@emp.EmployeeId" selected="@(Model.EmployeeId == emp.EmployeeId)">
                            @emp.FirstName @emp.LastName (@emp.LoginId)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow">
    <div class="card-header bg-white">
        <h5 class="mb-0">
            <i class="bi bi-table"></i> Attendance Records
            <span class="badge bg-primary">@Model.Attendances.Count</span>
        </h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Date</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Work Hours</th>
                        <th>Extra Hours</th>
                        <th>Status</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attendance in Model.Attendances)
                    {
                        <tr>
                            <td>@attendance.Employee.LoginId</td>
                            <td>@attendance.Employee.FirstName @attendance.Employee.LastName</td>
                            <td>@attendance.Date.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (attendance.CheckInTime != null)
                                {
                                    <span class="text-success fw-bold">@attendance.CheckInTime.Value.ToString("hh:mm tt")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (attendance.CheckOutTime != null)
                                {
                                    <span class="text-danger fw-bold">@attendance.CheckOutTime.Value.ToString("hh:mm tt")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (attendance.WorkHours > 0)
                                {
                                    <span>@attendance.WorkHours.ToString("F2") hrs</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (attendance.ExtraHours > 0)
                                {
                                    <span class="badge bg-info">+@attendance.ExtraHours.ToString("F2") hrs</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (attendance.Status == "Present")
                                {
                                    <span class="badge bg-success">Present</span>
                                }
                                else if (attendance.Status == "OnLeave")
                                {
                                    <span class="badge bg-info">On Leave</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Absent</span>
                                }
                            </td>
                            <td><small>@attendance.Remarks</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Attendances.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-3">No attendance records found for selected criteria</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Auto-submit on employee selection
        document.querySelector('select[name="employeeId"]').addEventListener('change', function() {
            this.form.submit();
        });
    </script>
}
