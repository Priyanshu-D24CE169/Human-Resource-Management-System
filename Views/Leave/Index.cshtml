@model hrms.ViewModels.LeaveRequestViewModel
@{
    ViewData["Title"] = "Leave Management";
}

<div class="page-header">
    <div class="page-title">
        <h2><i class="bi bi-calendar-x"></i> Leave Management</h2>
        <p class="text-muted mb-0">Manage your time off requests and balances</p>
    </div>
    <div class="header-actions">
        @if (!Model.IsAdmin)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Apply for Leave
            </a>
        }
    </div>
</div>

@if (!Model.IsAdmin && Model.CurrentEmployee != null)
{
    <!-- Employee Leave Balance Dashboard -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Leave Balance Overview</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="leave-balance-card pto-card">
                                <div class="leave-icon">
                                    <i class="bi bi-sun"></i>
                                </div>
                                <div class="leave-details">
                                    <h6 class="leave-type">Paid Time Off</h6>
                                    <h4 class="leave-count">@Model.CurrentEmployee.PTOStatus</h4>
                                    <div class="leave-progress">
                                        <div class="progress">
                                            <div class="progress-bar bg-primary" role="progressbar" 
                                                 style="width: @((double)Model.CurrentEmployee.AvailablePTO / Model.CurrentEmployee.PaidTimeOffBalance * 100)%" 
                                                 aria-valuenow="@Model.CurrentEmployee.AvailablePTO" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="@Model.CurrentEmployee.PaidTimeOffBalance">
                                            </div>
                                        </div>
                                        <small class="text-muted">
                                            @Model.CurrentEmployee.CurrentYearPTOUsed used of @Model.CurrentEmployee.PaidTimeOffBalance allocated
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="leave-balance-card sick-card">
                                <div class="leave-icon">
                                    <i class="bi bi-heart-pulse"></i>
                                </div>
                                <div class="leave-details">
                                    <h6 class="leave-type">Sick Time Off</h6>
                                    <h4 class="leave-count">@Model.CurrentEmployee.SickTimeStatus</h4>
                                    <div class="leave-progress">
                                        <div class="progress">
                                            <div class="progress-bar bg-success" role="progressbar" 
                                                 style="width: @((double)Model.CurrentEmployee.AvailableSickDays / Model.CurrentEmployee.SickTimeOffBalance * 100)%" 
                                                 aria-valuenow="@Model.CurrentEmployee.AvailableSickDays" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="@Model.CurrentEmployee.SickTimeOffBalance">
                                            </div>
                                        </div>
                                        <small class="text-muted">
                                            @Model.CurrentEmployee.CurrentYearSickUsed used of @Model.CurrentEmployee.SickTimeOffBalance allocated
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Leave Policy</h5>
                </div>
                <div class="card-body">
                    <div class="leave-policy">
                        <div class="policy-item">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            <span>Leave balances reset annually on January 1st</span>
                        </div>
                        <div class="policy-item">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            <span>PTO allocation increases with tenure</span>
                        </div>
                        <div class="policy-item">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            <span>Sick leave: 12 days per year for all employees</span>
                        </div>
                        <div class="policy-item">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            <span>Unpaid leave doesn't affect your balance</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.IsAdmin)
{
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5><i class="bi bi-clock-history me-2"></i>Pending Requests</h5>
                            <h2 class="text-warning">@Model.LeaveRequests.Count(l => l.Status == "Pending")</h2>
                            <small class="text-muted">Awaiting approval</small>
                        </div>
                        <div class="stats-icon">
                            <i class="bi bi-clock-history" style="font-size: 2rem; color: var(--warning-orange);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5><i class="bi bi-check-circle me-2"></i>Approved</h5>
                            <h2 class="text-success">@Model.LeaveRequests.Count(l => l.Status == "Approved")</h2>
                            <small class="text-muted">Approved requests</small>
                        </div>
                        <div class="stats-icon">
                            <i class="bi bi-check-circle" style="font-size: 2rem; color: var(--success-green);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5><i class="bi bi-x-circle me-2"></i>Rejected</h5>
                            <h2 class="text-danger">@Model.LeaveRequests.Count(l => l.Status == "Rejected")</h2>
                            <small class="text-muted">Declined requests</small>
                        </div>
                        <div class="stats-icon">
                            <i class="bi bi-x-circle" style="font-size: 2rem; color: var(--error-red);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stats-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5><i class="bi bi-list-ul me-2"></i>Total</h5>
                            <h2>@Model.LeaveRequests.Count</h2>
                            <small class="text-muted">All requests</small>
                        </div>
                        <div class="stats-icon">
                            <i class="bi bi-list-ul" style="font-size: 2rem; color: var(--accent-blue);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Leave Requests</h5>
            <span class="badge bg-primary">@Model.LeaveRequests.Count requests</span>
        </div>
    </div>
    <div class="card-body">
        @foreach (var leave in Model.LeaveRequests)
        {
            <div class="leave-request-card mb-3">
                <div class="card border-start border-5 @(leave.Status == "Pending" ? "border-warning" : leave.Status == "Approved" ? "border-success" : "border-danger")">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-2">
                                @if (Model.IsAdmin)
                                {
                                    <div class="text-center employee-info">
                                        @if (!string.IsNullOrEmpty(leave.Employee.ProfilePhotoPath))
                                        {
                                            <img src="@leave.Employee.ProfilePhotoPath" alt="Profile" 
                                                 class="rounded-circle mb-2" width="60" height="60" style="object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center bg-light mb-2"
                                                 style="width: 60px; height: 60px;">
                                                <i class="bi bi-person text-muted"></i>
                                            </div>
                                        }
                                        <p class="mb-0 small fw-bold">@leave.Employee.FirstName @leave.Employee.LastName</p>
                                        <small class="text-muted">@leave.Employee.LoginId</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center leave-type-icon">
                                        <div class="leave-icon-wrapper @(leave.LeaveType.ToLower())">
                                            <i class="bi bi-@(leave.LeaveType == "PaidLeave" ? "sun" : leave.LeaveType == "SickLeave" ? "heart-pulse" : "clock")" style="font-size: 2rem;"></i>
                                        </div>
                                        <small class="text-muted">@(leave.LeaveType == "PaidLeave" ? "PTO" : leave.LeaveType == "SickLeave" ? "Sick" : "Unpaid")</small>
                                    </div>
                                }
                            </div>
                            <div class="col-md-7">
                                <div class="leave-details">
                                    <div class="d-flex gap-2 mb-2">
                                        <span class="badge leave-type-badge @(leave.LeaveType.ToLower())">
                                            @(leave.LeaveType == "PaidLeave" ? "Paid Leave" : leave.LeaveType == "SickLeave" ? "Sick Leave" : "Unpaid Leave")
                                        </span>
                                        <span class="badge status-badge bg-@(leave.Status == "Pending" ? "warning" : leave.Status == "Approved" ? "success" : "danger")">
                                            @leave.Status
                                        </span>
                                    </div>
                                    <p class="mb-2">
                                        <i class="bi bi-calendar-range me-1 text-muted"></i>
                                        <strong>@leave.FromDate.ToString("dd MMM yyyy")</strong> to <strong>@leave.ToDate.ToString("dd MMM yyyy")</strong>
                                        <span class="badge bg-info ms-2">@leave.TotalDays day@(leave.TotalDays == 1 ? "" : "s")</span>
                                    </p>
                                    <p class="mb-2"><strong>Reason:</strong> @leave.Reason</p>
                                    @if (!string.IsNullOrEmpty(leave.AttachmentPath))
                                    {
                                        <p class="mb-2">
                                            <i class="bi bi-paperclip me-1 text-muted"></i>
                                            <a href="@leave.AttachmentPath" target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye me-1"></i> View Attachment
                                            </a>
                                        </p>
                                    }
                                    @if (!string.IsNullOrEmpty(leave.AdminRemarks))
                                    {
                                        <p class="mb-2 admin-remarks">
                                            <i class="bi bi-chat-square-text me-1 text-muted"></i>
                                            <strong>Admin Remarks:</strong> @leave.AdminRemarks
                                        </p>
                                    }
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i> Applied on @leave.RequestDate.ToString("dd MMM yyyy 'at' HH:mm")
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-3 text-end">
                                <div class="action-buttons">
                                    @if (Model.IsAdmin && leave.Status == "Pending")
                                    {
                                        <button type="button" class="btn btn-success btn-sm mb-2" 
                                                data-bs-toggle="modal" data-bs-target="#approveModal@(leave.LeaveRequestId)">
                                            <i class="bi bi-check-circle"></i> Approve
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm mb-2" 
                                                data-bs-toggle="modal" data-bs-target="#rejectModal@(leave.LeaveRequestId)">
                                            <i class="bi bi-x-circle"></i> Reject
                                        </button>

                                        <!-- Approve Modal -->
                                        <div class="modal fade" id="approveModal@(leave.LeaveRequestId)" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="Approve" method="post">
                                                        <input type="hidden" name="id" value="@leave.LeaveRequestId" />
                                                        <div class="modal-header bg-success text-white">
                                                            <h5 class="modal-title">Approve Leave Request</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p>Confirm approval for <strong>@leave.Employee.FirstName @leave.Employee.LastName</strong>:</p>
                                                            <ul class="list-unstyled">
                                                                <li><strong>Type:</strong> @(leave.LeaveType == "PaidLeave" ? "Paid Leave" : leave.LeaveType == "SickLeave" ? "Sick Leave" : "Unpaid Leave")</li>
                                                                <li><strong>Duration:</strong> @leave.TotalDays day@(leave.TotalDays == 1 ? "" : "s")</li>
                                                                <li><strong>Dates:</strong> @leave.FromDate.ToString("dd MMM") - @leave.ToDate.ToString("dd MMM yyyy")</li>
                                                            </ul>
                                                            @if (leave.LeaveType != "UnpaidLeave")
                                                            {
                                                                <div class="alert alert-info">
                                                                    <i class="bi bi-info-circle me-1"></i>
                                                                    <strong>@leave.TotalDays</strong> day@(leave.TotalDays == 1 ? "" : "s") will be deducted from the employee's @(leave.LeaveType == "PaidLeave" ? "PTO" : "sick leave") balance.
                                                                </div>
                                                            }
                                                            <div class="mb-3">
                                                                <label class="form-label">Remarks (Optional)</label>
                                                                <textarea name="remarks" class="form-control" rows="3" placeholder="Add any comments..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-success">Approve Request</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Reject Modal -->
                                        <div class="modal fade" id="rejectModal@(leave.LeaveRequestId)" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="Reject" method="post">
                                                        <input type="hidden" name="id" value="@leave.LeaveRequestId" />
                                                        <div class="modal-header bg-danger text-white">
                                                            <h5 class="modal-title">Reject Leave Request</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p>Reject request for <strong>@leave.Employee.FirstName @leave.Employee.LastName</strong>:</p>
                                                            <div class="mb-3">
                                                                <label class="form-label">Reason for Rejection <span class="text-danger">*</span></label>
                                                                <textarea name="remarks" class="form-control" rows="3" required 
                                                                          placeholder="Please provide a reason for rejection..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger">Reject Request</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (!Model.IsAdmin && (leave.Status == "Pending" || leave.Status == "Approved"))
                                    {
                                        <form asp-action="Cancel" method="post" class="d-inline" 
                                              onsubmit="return confirm('@(leave.Status == "Approved" ? "This will restore your leave balance. " : "")Are you sure you want to cancel this request?');">
                                            <input type="hidden" name="id" value="@leave.LeaveRequestId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        @if (leave.ApprovedDate != null)
                                        {
                                            <small class="text-muted processed-info">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Processed on @leave.ApprovedDate.Value.ToString("dd MMM yyyy")
                                                <br>by <strong>@leave.ApprovedBy</strong>
                                            </small>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.LeaveRequests.Any())
        {
            <div class="empty-state text-center py-5">
                <div class="empty-state-icon mb-4">
                    <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
                </div>
                <h5 class="text-muted">No Leave Requests Found</h5>
                <p class="text-muted mb-4">@(Model.IsAdmin ? "No leave requests have been submitted yet." : "You haven't applied for any leave yet.")</p>
                @if (!Model.IsAdmin)
                {
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Apply for Leave
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <style>
        .leave-balance-card {
            border: 1px solid var(--border-light);
            border-radius: var(--border-radius);
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            height: 100%;
            transition: var(--transition);
        }
        
        .leave-balance-card:hover {
            box-shadow: var(--shadow-light);
        }
        
        .leave-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        
        .pto-card .leave-icon {
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal));
            color: white;
        }
        
        .sick-card .leave-icon {
            background: linear-gradient(135deg, var(--success-green), #27ae60);
            color: white;
        }
        
        .leave-details {
            flex: 1;
        }
        
        .leave-type {
            font-size: 0.9rem;
            color: var(--medium-gray);
            margin-bottom: 4px;
            font-weight: 500;
        }
        
        .leave-count {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--primary-charcoal);
            margin-bottom: 8px;
        }
        
        .leave-progress .progress {
            height: 6px;
            margin-bottom: 4px;
        }
        
        .policy-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 12px;
            font-size: 0.9rem;
        }
        
        .leave-request-card {
            transition: var(--transition);
        }
        
        .leave-request-card:hover {
            transform: translateY(-2px);
        }
        
        .leave-type-badge.paidleave {
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-teal)) !important;
            color: white;
        }
        
        .leave-type-badge.sickleave {
            background: var(--success-green) !important;
            color: white;
        }
        
        .leave-type-badge.unpaidleave {
            background: var(--medium-gray) !important;
            color: white;
        }
        
        .leave-icon-wrapper {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 8px;
        }
        
        .leave-icon-wrapper.paidleave {
            background: linear-gradient(135deg, rgba(52, 152, 219, 0.1), rgba(22, 160, 133, 0.1));
            color: var(--accent-blue);
        }
        
        .leave-icon-wrapper.sickleave {
            background: rgba(39, 174, 96, 0.1);
            color: var(--success-green);
        }
        
        .leave-icon-wrapper.unpaidleave {
            background: rgba(108, 117, 125, 0.1);
            color: var(--medium-gray);
        }
        
        .admin-remarks {
            background: var(--light-gray);
            padding: 8px 12px;
            border-radius: var(--border-radius);
            border-left: 3px solid var(--accent-blue);
        }
        
        .processed-info {
            background: var(--light-gray);
            padding: 8px;
            border-radius: var(--border-radius);
            display: inline-block;
        }
        
        .action-buttons .btn {
            width: 100%;
            margin-bottom: 8px;
        }
        
        .action-buttons .btn:last-child {
            margin-bottom: 0;
        }
    </style>
}
