<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HRMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Header -->
    <header class="top-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                    <div class="brand-container">
                        <div class="brand-icon">
                            <i class="bi bi-building-check"></i>
                        </div>
                        <div class="brand-text">
                            <span class="brand-title">HRMS</span>
                            <span class="brand-subtitle">Human Resource Management</span>
                        </div>
                    </div>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="navbar-nav ms-auto d-flex align-items-center">
                        <!-- Header Systray Status Indicator -->
                        @if (!User.IsInRole("Admin"))
                        {
                            <div class="nav-item me-3">
                                <div class="status-indicator-systray" id="userStatusSystray">
                                    <button type="button" class="btn-status-systray" data-bs-toggle="dropdown" aria-expanded="false">
                                        <div class="status-dot" id="statusDot">
                                            <i class="bi bi-circle-fill text-danger"></i>
                                        </div>
                                        <span class="status-text" id="statusText">Check In</span>
                                    </button>
                                    
                                    <!-- Quick Check In/Out Dropdown -->
                                    <div class="dropdown-menu dropdown-menu-end status-dropdown" id="statusDropdown">
                                        <div class="dropdown-header">
                                            <strong>Attendance Status</strong>
                                        </div>
                                        <div class="status-content" id="statusContent">
                                            <div class="text-center py-3">
                                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                                <p class="mb-0 mt-2 small">Loading status...</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        <div class="nav-item dropdown user-dropdown">
                            <a class="nav-link dropdown-toggle user-menu" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                <div class="user-info">
                                    <span class="user-name">@User.Identity.Name</span>
                                    <span class="user-role">@(User.IsInRole("Admin") ? "Administrator" : "Employee")</span>
                                </div>
                                <i class="bi bi-chevron-down"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu">
                                <li class="dropdown-header">
                                    <div class="user-details">
                                        <strong>@User.Identity.Name</strong>
                                        <small class="text-muted d-block">@(User.IsInRole("Admin") ? "System Administrator" : "Employee")</small>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Employee" asp-action="Profile">
                                        <i class="bi bi-person me-2"></i> My Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key me-2"></i> Change Password
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                    
                    <!-- Mobile menu toggle -->
                    <button class="navbar-toggler d-lg-none ms-3" type="button" onclick="toggleSidebar()">
                        <i class="bi bi-list"></i>
                    </button>
                }
            </div>
        </nav>
    </header>

    <div class="main-layout">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <!-- Sidebar Navigation -->
            <nav class="sidebar" id="sidebarMenu">
                <div class="sidebar-content">
                    <ul class="nav nav-pills flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" 
                               asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Employee" ? "active" : "")" 
                                   asp-controller="Employee" asp-action="Index">
                                    <i class="bi bi-people"></i>
                                    <span>Employees</span>
                                </a>
                            </li>
                        }
                        
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Attendance" && ViewContext.RouteData.Values["Action"]?.ToString() != "Report" ? "active" : "")" 
                               asp-controller="Attendance" asp-action="Index">
                                <i class="bi bi-clock"></i>
                                <span>Attendance</span>
                            </a>
                        </li>
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Attendance" && ViewContext.RouteData.Values["Action"]?.ToString() == "Report" ? "active" : "")" 
                                   asp-controller="Attendance" asp-action="Report">
                                    <i class="bi bi-bar-chart"></i>
                                    <span>Reports</span>
                                </a>
                            </li>
                        }
                        
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Leave" ? "active" : "")" 
                               asp-controller="Leave" asp-action="Index">
                                <i class="bi bi-calendar-x"></i>
                                <span>Leave Management</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        }

        <!-- Main Content -->
        <main class="main-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show custom-alert" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show custom-alert" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["EmailWarning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show custom-alert" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @TempData["EmailWarning"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="content-wrapper">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        // Enhanced sidebar toggle function
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebarMenu');
            const overlay = document.getElementById('sidebarOverlay');
            
            if (sidebar.classList.contains('show')) {
                // Hide sidebar
                sidebar.classList.remove('show');
                if (overlay) {
                    overlay.classList.remove('show');
                    setTimeout(() => overlay.remove(), 300);
                }
                document.body.style.overflow = '';
            } else {
                // Show sidebar
                sidebar.classList.add('show');
                
                // Create overlay if it doesn't exist
                if (!overlay) {
                    const newOverlay = document.createElement('div');
                    newOverlay.id = 'sidebarOverlay';
                    newOverlay.className = 'sidebar-overlay';
                    newOverlay.style.cssText = `
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        background: rgba(0, 0, 0, 0.5);
                        z-index: 1020;
                        opacity: 0;
                        visibility: hidden;
                        transition: all 0.3s ease;
                    `;
                    newOverlay.onclick = toggleSidebar;
                    document.body.appendChild(newOverlay);
                    
                    setTimeout(() => {
                        newOverlay.classList.add('show');
                        newOverlay.style.opacity = '1';
                        newOverlay.style.visibility = 'visible';
                    }, 10);
                }
                
                document.body.style.overflow = 'hidden';
            }
        }
        
        // Close sidebar on window resize for desktop
        window.addEventListener('resize', function() {
            if (window.innerWidth >= 992) {
                const sidebar = document.getElementById('sidebarMenu');
                const overlay = document.getElementById('sidebarOverlay');
                if (sidebar?.classList.contains('show')) {
                    sidebar.classList.remove('show');
                    if (overlay) {
                        overlay.remove();
                    }
                    document.body.style.overflow = '';
                }
            }
        });

        // Initialize Header Systray Status Indicator
        document.addEventListener('DOMContentLoaded', function() {
            initializeStatusSystray();
        });

        function initializeStatusSystray() {
            const statusSystray = document.getElementById('userStatusSystray');
            if (!statusSystray) return;

            // Load initial status
            loadUserAttendanceStatus();
            
            // Refresh status every 30 seconds
            setInterval(loadUserAttendanceStatus, 30000);
        }

        function loadUserAttendanceStatus() {
            fetch('/api/attendance/status')
                .then(response => response.json())
                .then(data => updateStatusSystray(data))
                .catch(error => {
                    console.error('Error loading attendance status:', error);
                    updateStatusSystray({ hasCheckedIn: false, error: true });
                });
        }

        function updateStatusSystray(status) {
            const statusDot = document.getElementById('statusDot');
            const statusText = document.getElementById('statusText');
            const statusContent = document.getElementById('statusContent');

            if (status.error) {
                statusDot.innerHTML = '<i class="bi bi-circle-fill text-secondary"></i>';
                statusText.textContent = 'Offline';
                statusContent.innerHTML = '<div class="text-center py-3"><i class="bi bi-wifi-off text-muted"></i><p class="mb-0 mt-2 small text-muted">Connection Error</p></div>';
                return;
            }

            if (status.hasCheckedIn) {
                // 🟢 Green Dot (Active/Working)
                statusDot.innerHTML = '<i class="bi bi-circle-fill text-success"></i>';
                statusText.textContent = 'Working';
                
                const checkInTime = new Date(status.checkInTime).toLocaleTimeString('en-US', { 
                    hour: '2-digit', 
                    minute: '2-digit' 
                });
                
                let workingHours = '';
                if (status.checkInTime) {
                    const now = new Date();
                    const checkIn = new Date(status.checkInTime);
                    const diffMs = now - checkIn;
                    const hours = Math.floor(diffMs / (1000 * 60 * 60));
                    const minutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
                    workingHours = `${hours}h ${minutes}m`;
                }

                statusContent.innerHTML = `
                    <div class="status-check-out">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <i class="bi bi-check-circle text-success me-2"></i>
                                <strong>Checked In</strong>
                            </div>
                            <span class="badge bg-success">${checkInTime}</span>
                        </div>
                        ${workingHours ? `<p class="small text-muted mb-3">Working time: <strong>${workingHours}</strong></p>` : ''}
                        ${status.canCheckOut ? `
                            <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="performCheckOut()">
                                <i class="bi bi-box-arrow-right me-1"></i> Check Out
                            </button>
                        ` : `
                            <div class="text-center">
                                <i class="bi bi-check-circle text-success"></i>
                                <p class="small text-muted mb-0">Already checked out today</p>
                            </div>
                        `}
                    </div>
                `;
            } else {
                // 🔴 Red Dot (Not Checked In)
                statusDot.innerHTML = '<i class="bi bi-circle-fill text-danger"></i>';
                statusText.textContent = 'Check In';
                
                statusContent.innerHTML = `
                    <div class="status-check-in">
                        <div class="text-center mb-3">
                            <i class="bi bi-clock text-danger" style="font-size: 2rem;"></i>
                            <p class="mb-0 mt-2"><strong>Not Checked In</strong></p>
                            <small class="text-muted">Start your workday</small>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm w-100" onclick="performCheckIn()">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Check In Now
                        </button>
                    </div>
                `;
            }
        }

        function performCheckIn() {
            const content = document.getElementById('statusContent');
            content.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary" role="status"></div><p class="mb-0 mt-2 small">Checking in...</p></div>';

            fetch('/Attendance/CheckIn', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    loadUserAttendanceStatus(); // Refresh status
                    // Show success feedback
                    HRMS.showNotification('Successfully checked in!', 'success');
                } else {
                    content.innerHTML = `<div class="text-center py-3 text-danger"><i class="bi bi-exclamation-circle"></i><p class="mb-0 mt-2 small">${data.message || 'Check in failed'}</p></div>`;
                }
            })
            .catch(error => {
                console.error('Check in error:', error);
                content.innerHTML = '<div class="text-center py-3 text-danger"><i class="bi bi-exclamation-circle"></i><p class="mb-0 mt-2 small">Check in failed</p></div>';
            });
        }

        function performCheckOut() {
            const content = document.getElementById('statusContent');
            content.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary" role="status"></div><p class="mb-0 mt-2 small">Checking out...</p></div>';

            fetch('/Attendance/CheckOut', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    loadUserAttendanceStatus(); // Refresh status
                    // Show success feedback
                    HRMS.showNotification(`Successfully checked out! Working time: ${data.workingHours || 'N/A'}`, 'success');
                } else {
                    content.innerHTML = `<div class="text-center py-3 text-danger"><i class="bi bi-exclamation-circle"></i><p class="mb-0 mt-2 small">${data.message || 'Check out failed'}</p></div>`;
                }
            })
            .catch(error => {
                console.error('Check out error:', error);
                content.innerHTML = '<div class="text-center py-3 text-danger"><i class="bi bi-exclamation-circle"></i><p class="mb-0 mt-2 small">Check out failed</p></div>';
            });
        }
    </script>
</body>
</html>
