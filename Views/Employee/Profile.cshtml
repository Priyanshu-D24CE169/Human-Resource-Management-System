@model hrms.ViewModels.EmployeeProfileViewModel
@{
    ViewData["Title"] = "Employee Profile";
    var activeTab = ViewBag.ActiveTab ?? "resume";
}

<div class="row mb-4">
    <div class="col">
        <h2><i class="bi bi-person"></i> Employee Profile</h2>
    </div>
    <div class="col-auto">
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Employee.EmployeeId" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit Profile
            </a>
        }
        @if (Model.CanEditSalary)
        {
            <div class="btn-group ms-2">
                <button type="button" class="btn btn-warning dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="bi bi-gear"></i> Admin Actions
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <h6 class="dropdown-header">Credential Management</h6>
                    </li>
                    <li>
                        <form asp-action="ResendCredentials" asp-route-id="@Model.Employee.EmployeeId" method="post" 
                              onsubmit="return confirm('Send login ID reminder to @Model.Employee.Email?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item">
                                <i class="bi bi-envelope"></i> Resend Login ID
                            </button>
                        </form>
                    </li>
                    <li>
                        <form asp-action="ResetPasswordAndResend" asp-route-id="@Model.Employee.EmployeeId" method="post" 
                              onsubmit="return confirm('Reset password and send new credentials to @Model.Employee.Email? This will invalidate their current password.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-key"></i> Reset Password & Send
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card shadow mb-4">
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.Employee.ProfilePhotoPath))
                {
                    <img src="@Model.Employee.ProfilePhotoPath" alt="Profile" 
                         class="rounded-circle img-fluid mb-3" style="width: 150px; height: 150px; object-fit: cover;">
                }
                else
                {
                    <i class="bi bi-person-circle text-muted mb-3" style="font-size: 10rem;"></i>
                }
                <h5>@Model.Employee.FirstName @Model.Employee.LastName</h5>
                <p class="text-muted mb-1">@Model.Employee.Designation</p>
                <p class="text-muted">@Model.Employee.Department</p>
                <span class="badge bg-success">Active</span>
            </div>
        </div>

        <div class="card shadow">
            <div class="card-body">
                <h6 class="mb-3"><i class="bi bi-info-circle"></i> Quick Info</h6>
                <p class="mb-2">
                    <strong>Login ID:</strong><br>
                    <span class="text-muted">@Model.Employee.LoginId</span>
                </p>
                <p class="mb-2">
                    <strong>Email:</strong><br>
                    <span class="text-muted">@Model.Employee.Email</span>
                </p>
                <p class="mb-2">
                    <strong>Phone:</strong><br>
                    <span class="text-muted">@Model.Employee.PhoneNumber</span>
                </p>
                <p class="mb-0">
                    <strong>Joining Date:</strong><br>
                    <span class="text-muted">@Model.Employee.JoiningDate.ToString("dd MMM yyyy")</span>
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <div class="card shadow">
            <div class="card-header bg-white">
                <ul class="nav nav-tabs card-header-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#resume">
                            <i class="bi bi-file-earmark-text"></i> Resume
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#private">
                            <i class="bi bi-lock"></i> Private Info
                        </a>
                    </li>
                    @if (Model.CanEditSalary)
                    {
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#salary">
                                <i class="bi bi-currency-rupee"></i> Salary Info
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#security">
                            <i class="bi bi-shield-check"></i> Security
                        </a>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    <!-- Resume Tab -->
                    <div class="tab-pane fade show active" id="resume">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">First Name</label>
                                <p>@Model.Employee.FirstName</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Last Name</label>
                                <p>@Model.Employee.LastName</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Date of Birth</label>
                                <p>@Model.Employee.DateOfBirth.ToString("dd MMM yyyy")</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Gender</label>
                                <p>@Model.Employee.Gender</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Department</label>
                                <p>@Model.Employee.Department</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Designation</label>
                                <p>@Model.Employee.Designation</p>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold">Address</label>
                                <p>@Model.Employee.Address, @Model.Employee.City, @Model.Employee.State - @Model.Employee.ZipCode</p>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Employee.ResumePath))
                            {
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">Resume</label>
                                    <p>
                                        <a href="@Model.Employee.ResumePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-download"></i> Download Resume
                                        </a>
                                    </p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Private Info Tab -->
                    <div class="tab-pane fade" id="private">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Emergency Contact Name</label>
                                <p>@Model.Employee.EmergencyContactName</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Emergency Contact Phone</label>
                                <p>@Model.Employee.EmergencyContactPhone</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Bank Name</label>
                                <p>@Model.Employee.BankName</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Account Number</label>
                                <p>@Model.Employee.AccountNumber</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">IFSC Code</label>
                                <p>@Model.Employee.IFSCCode</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">PAN Number</label>
                                <p>@Model.Employee.PANNumber</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Aadhar Number</label>
                                <p>@Model.Employee.AadharNumber</p>
                            </div>
                        </div>
                    </div>

                    <!-- Salary Info Tab -->
                    @if (Model.CanEditSalary)
                    {
                        <div class="tab-pane fade" id="salary">
                            @if (Model.Salary != null)
                            {
                                <form asp-controller="Employee" asp-action="UpdateSalary" method="post">
                                    <input type="hidden" name="employeeId" value="@Model.Employee.EmployeeId" />
                                    <input type="hidden" asp-for="@Model.Salary.SalaryId" />
                                    <input type="hidden" asp-for="@Model.Salary.EmployeeId" />
                                    
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Monthly Wage <span class="text-danger">*</span></label>
                                            <input asp-for="@Model.Salary.MonthlyWage" class="form-control" type="number" step="0.01" required />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Working Days Per Month <span class="text-danger">*</span></label>
                                            <input asp-for="@Model.Salary.WorkingDaysPerMonth" class="form-control" type="number" value="26" required />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Basic (typically 50%)</label>
                                            <input asp-for="@Model.Salary.Basic" class="form-control" type="number" step="0.01" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">HRA (typically 20%)</label>
                                            <input asp-for="@Model.Salary.HRA" class="form-control" type="number" step="0.01" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">PF (typically 12%)</label>
                                            <input asp-for="@Model.Salary.PF" class="form-control" type="number" step="0.01" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Allowances</label>
                                            <input asp-for="@Model.Salary.Allowances" class="form-control" type="number" step="0.01" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Deductions</label>
                                            <input asp-for="@Model.Salary.Deductions" class="form-control" type="number" step="0.01" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Professional Tax</label>
                                            <input asp-for="@Model.Salary.ProfessionalTax" class="form-control" type="number" step="0.01" value="200" />
                                        </div>
                                    </div>
                                    
                                    <div class="alert alert-info">
                                        <strong>Calculated Values:</strong><br>
                                        Yearly Wage: ?@((Model.Salary.MonthlyWage * 12).ToString("N2"))<br>
                                        Per Day Wage: ?@((Model.Salary.MonthlyWage / Model.Salary.WorkingDaysPerMonth).ToString("N2"))
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="bi bi-check-circle"></i> Update Salary
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <strong>No salary information available for this employee.</strong>
                                </div>
                                
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title">Create Salary Information</h5>
                                        <p class="card-text">Add salary details for this employee.</p>
                                        
                                        <form asp-controller="Employee" asp-action="UpdateSalary" method="post">
                                            <input type="hidden" name="employeeId" value="@Model.Employee.EmployeeId" />
                                            <input type="hidden" name="Salary.EmployeeId" value="@Model.Employee.EmployeeId" />
                                            
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Monthly Wage <span class="text-danger">*</span></label>
                                                    <input name="Salary.MonthlyWage" class="form-control" type="number" step="0.01" value="30000" required />
                                                    <small class="text-muted">Default: ?30,000</small>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Working Days Per Month <span class="text-danger">*</span></label>
                                                    <input name="Salary.WorkingDaysPerMonth" class="form-control" type="number" value="26" required />
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Basic (50%)</label>
                                                    <input name="Salary.Basic" class="form-control" type="number" step="0.01" value="15000" />
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">HRA (20%)</label>
                                                    <input name="Salary.HRA" class="form-control" type="number" step="0.01" value="6000" />
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">PF (12%)</label>
                                                    <input name="Salary.PF" class="form-control" type="number" step="0.01" value="3600" />
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Allowances (10%)</label>
                                                    <input name="Salary.Allowances" class="form-control" type="number" step="0.01" value="3000" />
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Deductions</label>
                                                    <input name="Salary.Deductions" class="form-control" type="number" step="0.01" value="0" />
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Professional Tax</label>
                                                    <input name="Salary.ProfessionalTax" class="form-control" type="number" step="0.01" value="200" />
                                                </div>
                                            </div>
                                            
                                            <div class="alert alert-info">
                                                <i class="bi bi-info-circle"></i>
                                                <strong>Default Breakdown:</strong><br>
                                                • Monthly Wage: ?30,000<br>
                                                • Basic (50%): ?15,000<br>
                                                • HRA (20%): ?6,000<br>
                                                • PF (12%): ?3,600<br>
                                                • Allowances (10%): ?3,000<br>
                                                • Professional Tax: ?200
                                            </div>

                                            <button type="submit" class="btn btn-success btn-lg">
                                                <i class="bi bi-plus-circle"></i> Create Salary Information
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Security Tab -->
                    <div class="tab-pane fade" id="security">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Login ID</label>
                            <p class="text-muted">@Model.Employee.LoginId</p>
                        </div>
                        <div class="mb-3">
                            <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-primary">
                                <i class="bi bi-key"></i> Change Password
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
