{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=HrmsDatabase;Integrated Security=true;MultipleActiveResultSets=true;TrustServerCertificate=true;",
    "LocalDbConnection": "Server=(localdb)\\MSSQLLocalDB;Database=HrmsDatabase;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true;",
    "IntranetSqlServerIP": "Server=YOUR_IP_ADDRESS,1433;Database=HrmsDatabase;User Id=YOUR_SQL_USERNAME;Password=YOUR_SQL_PASSWORD;MultipleActiveResultSets=true;TrustServerCertificate=true;Encrypt=false;",
    "IntranetSqlServerHostname": "Server=YOUR_HOSTNAME\\SQLEXPRESS;Database=HrmsDatabase;User Id=YOUR_SQL_USERNAME;Password=YOUR_SQL_PASSWORD;MultipleActiveResultSets=true;TrustServerCertificate=true;Encrypt=false;"
  },
  "NetworkSettings": {
    "EnableNetworkAccess": true,
    "Port": 7037,
    "HttpPort": 5194
  },
  "DatabaseSettings": {
    "UseIntranetServer": false,
    "PreferHostnameOverIP": true,
    "SqlServerIP": "",
    "SqlServerHostname": "YOUR_HOSTNAME",
    "SqlUsername": "YOUR_SQL_USERNAME",
    "SqlPassword": "YOUR_SQL_PASSWORD"
  }
}
