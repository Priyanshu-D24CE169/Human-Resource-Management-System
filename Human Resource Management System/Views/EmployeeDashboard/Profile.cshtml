@model Human_Resource_Management_System.Models.Employee
@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

<style>
    .profile-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
    }
    .profile-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 25px;
        margin-bottom: 20px;
    }
    .profile-image {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 4px solid rgba(255,255,255,0.3);
        object-fit: cover;
    }
    .completion-badge {
        display: inline-block;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }
    .completion-high {
        background: #dcfce7;
        color: #166534;
    }
    .completion-medium {
        background: #fef3c7;
        color: #d97706;
    }
    .completion-low {
        background: #fef2f2;
        color: #dc2626;
    }
    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f3f4f6;
    }
    .info-row:last-child {
        border-bottom: none;
    }
    .info-label {
        font-weight: 600;
        color: #6b7280;
        flex: 1;
    }
    .info-value {
        flex: 2;
        text-align: right;
        color: #374151;
        font-weight: 500;
    }
</style>

<div class="container">
    <!-- Profile Header -->
    <div class="profile-header">
        <div class="row align-items-center">
            <div class="col-md-2 text-center">
                @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                {
                    <img src="@Model.ProfileImagePath" alt="@Model.FullName" class="profile-image">
                }
                else
                {
                    <div class="profile-image d-flex align-items-center justify-content-center bg-white text-primary mx-auto" style="font-size: 2.5rem; font-weight: bold;">
                        @(Model.FirstName.FirstOrDefault())@(Model.LastName.FirstOrDefault())
                    </div>
                }
            </div>
            <div class="col-md-7">
                <h2 class="mb-2">@Model.FullName</h2>
                <p class="mb-1"><i class="fas fa-id-card me-2"></i>Employee Code: @Model.EmployeeCode</p>
                <p class="mb-1"><i class="fas fa-briefcase me-2"></i>@Model.Position</p>
                <p class="mb-0"><i class="fas fa-building me-2"></i>@Model.Department</p>
            </div>
            <div class="col-md-3 text-end">
                <div class="mb-3">
                    <span class="completion-badge @(Model.GetProfileCompletionPercentage() >= 80 ? "completion-high" : Model.GetProfileCompletionPercentage() >= 60 ? "completion-medium" : "completion-low")">
                        @((int)Model.GetProfileCompletionPercentage())% Complete
                    </span>
                </div>
                <a asp-action="EditProfile" class="btn btn-light">
                    <i class="fas fa-edit"></i> Edit Profile
                </a>
                <a asp-action="Index" class="btn btn-outline-light">
                    <i class="fas fa-home"></i> Dashboard
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(TempData["Success"] as string))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.IsProfileComplete())
    {
        <div class="alert alert-warning">
            <h6><i class="fas fa-exclamation-triangle me-2"></i>Profile Incomplete</h6>
            <p class="mb-1">Some fields are missing. Complete your profile to access all features:</p>
            <ul class="mb-2">
                @foreach (var field in Model.GetMissingProfileFields())
                {
                    <li>@field</li>
                }
            </ul>
            <a asp-action="EditProfile" class="btn btn-warning btn-sm">
                <i class="fas fa-edit"></i> Complete Profile
            </a>
        </div>
    }

    <div class="row">
        <!-- Personal Information -->
        <div class="col-lg-6">
            <div class="profile-card">
                <h5><i class="fas fa-user me-2 text-primary"></i>Personal Information</h5>
                <div class="info-row">
                    <span class="info-label">First Name</span>
                    <span class="info-value">@Model.FirstName</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Last Name</span>
                    <span class="info-value">@Model.LastName</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Email</span>
                    <span class="info-value">
                        <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Phone</span>
                    <span class="info-value">
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <a href="tel:@Model.Phone" class="text-decoration-none">@Model.Phone</a>
                        }
                        else
                        {
                            <span class="text-muted">Not provided</span>
                        }
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Date of Birth</span>
                    <span class="info-value">
                        @(Model.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "Not provided")
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Gender</span>
                    <span class="info-value">@(Model.Gender ?? "Not provided")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Nationality</span>
                    <span class="info-value">@(Model.Nationality ?? "Not provided")</span>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="profile-card">
                <h5><i class="fas fa-address-card me-2 text-primary"></i>Contact Information</h5>
                <div class="info-row">
                    <span class="info-label">Address</span>
                    <span class="info-value text-start">
                        @(Model.Address ?? "Not provided")
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Emergency Contact</span>
                    <span class="info-value">@(Model.EmergencyContactName ?? "Not provided")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Emergency Phone</span>
                    <span class="info-value">
                        @if (!string.IsNullOrEmpty(Model.EmergencyContactPhone))
                        {
                            <a href="tel:@Model.EmergencyContactPhone" class="text-decoration-none">@Model.EmergencyContactPhone</a>
                        }
                        else
                        {
                            <span class="text-muted">Not provided</span>
                        }
                    </span>
                </div>
            </div>
        </div>

        <!-- Employment Information -->
        <div class="col-lg-6">
            <div class="profile-card">
                <h5><i class="fas fa-briefcase me-2 text-primary"></i>Employment Information</h5>
                <div class="info-row">
                    <span class="info-label">Employee Code</span>
                    <span class="info-value">
                        <code style="background: #f3f4f6; padding: 4px 8px; border-radius: 4px; font-weight: bold;">@Model.EmployeeCode</code>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Department</span>
                    <span class="info-value">
                        <span class="badge bg-light text-dark">@Model.Department</span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Position</span>
                    <span class="info-value">@Model.Position</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Hire Date</span>
                    <span class="info-value">@Model.HireDate.ToString("MMMM dd, yyyy")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Years of Service</span>
                    <span class="info-value">
                        @{
                            var yearsOfService = Math.Round((DateTime.Now - Model.HireDate).TotalDays / 365.25, 1);
                        }
                        @yearsOfService years
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Status</span>
                    <span class="info-value">
                        <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-warning")">
                            @Model.Status
                        </span>
                    </span>
                </div>
            </div>

            <!-- Account Information -->
            <div class="profile-card">
                <h5><i class="fas fa-cog me-2 text-primary"></i>Account Information</h5>
                <div class="info-row">
                    <span class="info-label">Registration Status</span>
                    <span class="info-value">
                        @if (Model.IsRegistrationComplete)
                        {
                            <span class="badge bg-success">
                                <i class="fas fa-check-circle"></i> Complete
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning">
                                <i class="fas fa-clock"></i> Pending
                            </span>
                        }
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Profile Completion</span>
                    <span class="info-value">
                        <div class="progress" style="width: 100px; height: 8px;">
                            <div class="progress-bar bg-success" role="progressbar" 
                                 style="width: @(Model.GetProfileCompletionPercentage())%"></div>
                        </div>
                        <small class="text-muted">@((int)Model.GetProfileCompletionPercentage())%</small>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Account Created</span>
                    <span class="info-value">@Model.CreatedDate.ToString("MMM dd, yyyy")</span>
                </div>
                @if (Model.ModifiedDate.HasValue)
                {
                    <div class="info-row">
                        <span class="info-label">Last Updated</span>
                        <span class="info-value">@Model.ModifiedDate.Value.ToString("MMM dd, yyyy")</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="text-center mt-4">
        <a asp-action="EditProfile" class="btn btn-primary me-3">
            <i class="fas fa-edit"></i> Edit Profile
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-home"></i> Back to Dashboard
        </a>
    </div>
</div>