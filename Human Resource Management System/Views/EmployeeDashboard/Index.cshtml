@model Human_Resource_Management_System.Models.EmployeeDashboardViewModel
@{
    ViewData["Title"] = "Employee Dashboard";
    Layout = "_Layout";
}

<style>
    .dashboard-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
    }
    .stats-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 25px;
        margin-bottom: 20px;
        border-left: 4px solid #667eea;
        transition: transform 0.3s ease;
    }
    .stats-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15);
    }
    .profile-image {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 4px solid rgba(255,255,255,0.3);
        object-fit: cover;
    }
    .completion-bar {
        height: 8px;
        background-color: #e5e7eb;
        border-radius: 4px;
        overflow: hidden;
    }
    .completion-fill {
        height: 100%;
        background: linear-gradient(90deg, #10b981, #059669);
        border-radius: 4px;
        transition: width 0.3s ease;
    }
    .quick-action {
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        text-decoration: none;
        color: #374151;
        transition: all 0.3s ease;
        display: block;
        margin-bottom: 15px;
    }
    .quick-action:hover {
        border-color: #667eea;
        color: #667eea;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(102, 126, 234, 0.2);
    }
    .stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: #667eea;
        margin-bottom: 5px;
    }
    .stat-label {
        color: #6b7280;
        font-weight: 500;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }
</style>

<div class="container-fluid">
    <!-- Welcome Header -->
    <div class="dashboard-header">
        <div class="row align-items-center">
            <div class="col-md-2 text-center">
                @if (!string.IsNullOrEmpty(Model.Employee.ProfileImagePath))
                {
                    <img src="@Model.Employee.ProfileImagePath" alt="@Model.Employee.FullName" class="profile-image">
                }
                else
                {
                    <div class="profile-image d-flex align-items-center justify-content-center bg-white text-primary mx-auto" style="font-size: 2rem; font-weight: bold;">
                        @(Model.Employee.FirstName.FirstOrDefault())@(Model.Employee.LastName.FirstOrDefault())
                    </div>
                }
            </div>
            <div class="col-md-7">
                <h2 class="mb-2">Welcome back, @Model.Employee.FirstName! ??</h2>
                <p class="mb-1"><i class="fas fa-id-card me-2"></i>Employee Code: @Model.Employee.EmployeeCode</p>
                <p class="mb-1"><i class="fas fa-briefcase me-2"></i>@Model.Employee.Position, @Model.Employee.Department</p>
                <p class="mb-0"><i class="fas fa-calendar me-2"></i>@Model.YearsOfService years of service</p>
            </div>
            <div class="col-md-3 text-end">
                <div class="mb-2">
                    <h5>Profile Completion</h5>
                    <div class="completion-bar">
                        <div class="completion-fill" style="width: @(Model.ProfileCompletionPercentage)%"></div>
                    </div>
                    <small>@Model.ProfileCompletionPercentage% Complete</small>
                </div>
                @if (!Model.IsProfileComplete)
                {
                    <a asp-action="EditProfile" class="btn btn-light btn-sm">
                        <i class="fas fa-edit"></i> Complete Profile
                    </a>
                }
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.IsProfileComplete)
    {
        <div class="alert alert-warning">
            <h6><i class="fas fa-exclamation-triangle me-2"></i>Profile Incomplete</h6>
            <p class="mb-1">Please complete your profile to access all features. Missing fields:</p>
            <ul class="mb-0">
                @foreach (var field in Model.MissingFields)
                {
                    <li>@field</li>
                }
            </ul>
            <a asp-action="EditProfile" class="btn btn-warning btn-sm mt-2">
                <i class="fas fa-edit"></i> Complete Now
            </a>
        </div>
    }

    <div class="row">
        <!-- Statistics Cards -->
        <div class="col-lg-8">
            <div class="row">
                <div class="col-md-3">
                    <div class="stats-card text-center">
                        <div class="stat-number">@Model.DaysWithCompany</div>
                        <div class="stat-label">Days with Company</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-card text-center">
                        <div class="stat-number">@Model.YearsOfService</div>
                        <div class="stat-label">Years of Service</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-card text-center">
                        <div class="stat-number">@(Model.NextBirthday.HasValue ? Model.DaysUntilBirthday : 0)</div>
                        <div class="stat-label">Days to Birthday</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stats-card text-center">
                        <div class="stat-number">@((int)Model.ProfileCompletionPercentage)%</div>
                        <div class="stat-label">Profile Complete</div>
                    </div>
                </div>
            </div>

            <!-- Recent Activities / Announcements -->
            <div class="stats-card">
                <h5><i class="fas fa-bullhorn me-2 text-primary"></i>Company Announcements</h5>
                <div class="alert alert-info">
                    <h6><i class="fas fa-info-circle me-2"></i>Welcome to Odoo India HRMS!</h6>
                    <p class="mb-0">Your account has been successfully set up. Explore the dashboard to manage your profile, track attendance, and access HR services.</p>
                </div>
                <div class="alert alert-light">
                    <h6><i class="fas fa-calendar me-2"></i>Upcoming Events</h6>
                    <ul class="mb-0">
                        <li>Team Meeting - Every Monday 10:00 AM</li>
                        <li>Monthly Review - Last Friday of the month</li>
                        <li>Birthday Celebrations - End of each month</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-lg-4">
            <div class="stats-card">
                <h5><i class="fas fa-bolt me-2 text-primary"></i>Quick Actions</h5>
                
                <a asp-action="Profile" class="quick-action">
                    <i class="fas fa-user fa-2x mb-2" style="color: #667eea;"></i>
                    <h6>View Profile</h6>
                    <small>See your complete profile information</small>
                </a>
                
                <a asp-action="EditProfile" class="quick-action">
                    <i class="fas fa-edit fa-2x mb-2" style="color: #10b981;"></i>
                    <h6>Edit Profile</h6>
                    <small>Update your personal information</small>
                </a>
                
                <a asp-action="Attendance" class="quick-action">
                    <i class="fas fa-clock fa-2x mb-2" style="color: #f59e0b;"></i>
                    <h6>Attendance</h6>
                    <small>View your attendance records</small>
                </a>
                
                <a asp-action="Payroll" class="quick-action">
                    <i class="fas fa-money-bill-wave fa-2x mb-2" style="color: #059669;"></i>
                    <h6>Payroll</h6>
                    <small>Access salary and payroll information</small>
                </a>
                
                <a asp-action="LeaveRequests" class="quick-action">
                    <i class="fas fa-calendar-check fa-2x mb-2" style="color: #dc2626;"></i>
                    <h6>Leave Requests</h6>
                    <small>Apply for leave and track requests</small>
                </a>
            </div>

            <!-- Profile Summary -->
            <div class="stats-card">
                <h5><i class="fas fa-user-circle me-2 text-primary"></i>Profile Summary</h5>
                <div class="row g-2">
                    <div class="col-12">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Employee Code:</span>
                            <strong>@Model.Employee.EmployeeCode</strong>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Department:</span>
                            <span class="badge bg-light text-dark">@Model.Employee.Department</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Position:</span>
                            <span>@Model.Employee.Position</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Join Date:</span>
                            <span>@Model.Employee.HireDate.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                    @if (Model.NextBirthday.HasValue)
                    {
                        <div class="col-12">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Next Birthday:</span>
                                <span>@Model.NextBirthday.Value.ToString("MMM dd")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>