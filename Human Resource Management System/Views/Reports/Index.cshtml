@{
    ViewData["Title"] = "Reports & Analytics";
}

<style>
    .report-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
        cursor: pointer;
    }
    .report-card:hover {
        transform: translateY(-5px);
    }
    .chart-container {
        height: 400px;
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
</style>

<div class="row mb-4">
    <div class="col-12">
        <h2 class="mb-0">Reports & Analytics</h2>
        <p class="text-muted">Generate comprehensive reports and view analytics</p>
    </div>
</div>

<!-- Quick Report Generation -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="report-card p-4 text-center">
            <div class="mb-3">
                <i class="fas fa-users fa-3x text-primary"></i>
            </div>
            <h6>Employee Report</h6>
            <p class="text-muted small mb-3">Complete employee details and statistics</p>
            <button class="btn btn-primary btn-sm">Generate</button>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="report-card p-4 text-center">
            <div class="mb-3">
                <i class="fas fa-clock fa-3x text-success"></i>
            </div>
            <h6>Attendance Report</h6>
            <p class="text-muted small mb-3">Attendance patterns and analysis</p>
            <button class="btn btn-success btn-sm">Generate</button>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="report-card p-4 text-center">
            <div class="mb-3">
                <i class="fas fa-dollar-sign fa-3x text-warning"></i>
            </div>
            <h6>Payroll Report</h6>
            <p class="text-muted small mb-3">Salary breakdowns and summaries</p>
            <button class="btn btn-warning btn-sm">Generate</button>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="report-card p-4 text-center">
            <div class="mb-3">
                <i class="fas fa-chart-line fa-3x text-info"></i>
            </div>
            <h6>Performance Report</h6>
            <p class="text-muted small mb-3">Employee performance metrics</p>
            <button class="btn btn-info btn-sm">Generate</button>
        </div>
    </div>
</div>

<!-- Analytics Dashboard -->
<div class="row mb-4">
    <div class="col-md-8">
        <div class="chart-container">
            <h5 class="mb-3">Employee Growth Trend</h5>
            <canvas id="employeeGrowthChart"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="chart-container">
            <h5 class="mb-3">Department Distribution</h5>
            <canvas id="departmentChart"></canvas>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="chart-container">
            <h5 class="mb-3">Monthly Attendance Rate</h5>
            <canvas id="attendanceChart"></canvas>
        </div>
    </div>
    <div class="col-md-6">
        <div class="chart-container">
            <h5 class="mb-3">Salary Distribution</h5>
            <canvas id="salaryChart"></canvas>
        </div>
    </div>
</div>

<!-- Custom Report Builder -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Custom Report Builder</h5>
            </div>
            <div class="card-body">
                <form>
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">Report Type</label>
                            <select class="form-select">
                                <option>Employee Data</option>
                                <option>Attendance Records</option>
                                <option>Payroll Information</option>
                                <option>Leave Management</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Date Range</label>
                            <select class="form-select">
                                <option>Last 7 days</option>
                                <option>Last 30 days</option>
                                <option>Last 3 months</option>
                                <option>Custom Range</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Department</label>
                            <select class="form-select">
                                <option>All Departments</option>
                                <option>IT</option>
                                <option>HR</option>
                                <option>Finance</option>
                                <option>Sales</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Format</label>
                            <select class="form-select">
                                <option>PDF</option>
                                <option>Excel</option>
                                <option>CSV</option>
                            </select>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="button" class="btn btn-primary">
                            <i class="fas fa-file-alt"></i> Generate Custom Report
                        </button>
                        <button type="button" class="btn btn-outline-secondary">
                            <i class="fas fa-save"></i> Save Template
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Employee Growth Chart
        const growthCtx = document.getElementById('employeeGrowthChart').getContext('2d');
        new Chart(growthCtx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [{
                    label: 'Total Employees',
                    data: [220, 225, 230, 235, 240, 245],
                    borderColor: '#667eea',
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        // Department Distribution Chart
        const deptCtx = document.getElementById('departmentChart').getContext('2d');
        new Chart(deptCtx, {
            type: 'doughnut',
            data: {
                labels: ['IT', 'HR', 'Finance', 'Sales', 'Marketing'],
                datasets: [{
                    data: [85, 25, 35, 55, 45],
                    backgroundColor: ['#667eea', '#764ba2', '#f093fb', '#f5576c', '#4facfe']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        // Attendance Chart
        const attCtx = document.getElementById('attendanceChart').getContext('2d');
        new Chart(attCtx, {
            type: 'bar',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [{
                    label: 'Attendance %',
                    data: [95, 92, 94, 91, 93, 92],
                    backgroundColor: '#43e97b'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100
                    }
                }
            }
        });

        // Salary Distribution Chart
        const salaryCtx = document.getElementById('salaryChart').getContext('2d');
        new Chart(salaryCtx, {
            type: 'bar',
            data: {
                labels: ['< 50k', '50k-70k', '70k-90k', '90k-120k', '> 120k'],
                datasets: [{
                    label: 'Number of Employees',
                    data: [25, 85, 95, 35, 15],
                    backgroundColor: '#4facfe'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    </script>
}