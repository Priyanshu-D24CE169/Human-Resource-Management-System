@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }
    .dashboard-card:hover {
        transform: translateY(-5px);
    }
    .stat-card {
        background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 15px;
        padding: 25px;
        text-align: center;
    }
    .stat-number {
        font-size: 2.5rem;
        font-weight: bold;
    }
    .chart-container {
        height: 300px;
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
</style>

<div class="row mb-4">
    <div class="col-12">
        <h2 class="mb-0">HR Dashboard</h2>
        <p class="text-muted">Welcome back! Here's what's happening with your HR operations today.</p>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="stat-card">
            <div class="stat-number">245</div>
            <div>Total Employees</div>
            <small><i class="fas fa-arrow-up"></i> +12 this month</small>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="stat-card" style="background: linear-gradient(45deg, #f093fb 0%, #f5576c 100%);">
            <div class="stat-number">92%</div>
            <div>Attendance Rate</div>
            <small><i class="fas fa-arrow-up"></i> +2% this week</small>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="stat-card" style="background: linear-gradient(45deg, #4facfe 0%, #00f2fe 100%);">
            <div class="stat-number">18</div>
            <div>Leave Requests</div>
            <small>Pending approval</small>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="stat-card" style="background: linear-gradient(45deg, #43e97b 0%, #38f9d7 100%);">
            <div class="stat-number">?2.4M</div>
            <div>Monthly Payroll</div>
            <small>Current month</small>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-12">
        <div class="dashboard-card p-4">
            <h5 class="mb-3">Quick Actions</h5>
            <div class="row">
                <div class="col-md-3 mb-2">
                    <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-primary w-100">
                        <i class="fas fa-users"></i> Manage Employees
                    </a>
                </div>
                <div class="col-md-3 mb-2">
                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-outline-success w-100">
                        <i class="fas fa-clock"></i> View Attendance
                    </a>
                </div>
                <div class="col-md-3 mb-2">
                    <a asp-controller="Payroll" asp-action="Index" class="btn btn-outline-info w-100">
                        <i class="fas fa-dollar-sign"></i> Payroll Management
                    </a>
                </div>
                <div class="col-md-3 mb-2">
                    <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-warning w-100">
                        <i class="fas fa-chart-bar"></i> Generate Reports
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activities and Charts -->
<div class="row">
    <div class="col-md-6">
        <div class="dashboard-card p-4">
            <h5 class="mb-3">Recent Activities</h5>
            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-user-plus text-success"></i>
                        <span class="ms-2">John Doe joined as Software Developer</span>
                    </div>
                    <small class="text-muted">2 hours ago</small>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-calendar-check text-primary"></i>
                        <span class="ms-2">Jane Smith submitted leave request</span>
                    </div>
                    <small class="text-muted">4 hours ago</small>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-dollar-sign text-info"></i>
                        <span class="ms-2">March payroll processing completed</span>
                    </div>
                    <small class="text-muted">1 day ago</small>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-user-edit text-warning"></i>
                        <span class="ms-2">Employee profile updated - Mike Johnson</span>
                    </div>
                    <small class="text-muted">2 days ago</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="chart-container">
            <h5 class="mb-3">Attendance Overview</h5>
            <canvas id="attendanceChart" width="400" height="200"></canvas>
        </div>
    </div>
</div>

<!-- Upcoming Events -->
<div class="row mt-4">
    <div class="col-12">
        <div class="dashboard-card p-4">
            <h5 class="mb-3">Upcoming Events & Deadlines</h5>
            <div class="row">
                <div class="col-md-4">
                    <div class="border-start border-primary ps-3">
                        <h6 class="text-primary">Team Building Event</h6>
                        <p class="mb-1">Annual company outing</p>
                        <small class="text-muted">March 25, 2024</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border-start border-warning ps-3">
                        <h6 class="text-warning">Performance Reviews</h6>
                        <p class="mb-1">Q1 performance evaluation deadline</p>
                        <small class="text-muted">March 30, 2024</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border-start border-success ps-3">
                        <h6 class="text-success">Salary Processing</h6>
                        <p class="mb-1">April salary processing</p>
                        <small class="text-muted">April 1, 2024</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Attendance Chart
        const ctx = document.getElementById('attendanceChart').getContext('2d');
        const attendanceChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
                datasets: [{
                    label: 'Attendance %',
                    data: [95, 92, 88, 94, 90, 85],
                    borderColor: '#667eea',
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100
                    }
                }
            }
        });
    </script>
}