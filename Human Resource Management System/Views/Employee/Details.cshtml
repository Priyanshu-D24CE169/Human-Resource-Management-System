@model Human_Resource_Management_System.Models.Employee
@{
    ViewData["Title"] = $"Employee Details - {Model.EmployeeCode}";
}

<style>
    .employee-header {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: white;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
    }
    .profile-image {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 4px solid rgba(255,255,255,0.3);
        object-fit: cover;
    }
    .employee-code {
        font-family: 'Courier New', monospace;
        background: rgba(255,255,255,0.2);
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: bold;
        display: inline-block;
    }
    .info-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 25px;
        margin-bottom: 20px;
        border-left: 4px solid #6366f1;
    }
    .info-card h5 {
        color: #374151;
        margin-bottom: 20px;
        font-weight: 600;
    }
    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f3f4f6;
    }
    .info-row:last-child {
        border-bottom: none;
    }
    .info-label {
        font-weight: 600;
        color: #6b7280;
        flex: 1;
    }
    .info-value {
        flex: 2;
        text-align: right;
        color: #374151;
        font-weight: 500;
    }
    .status-badge {
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .status-active {
        background: #dcfce7;
        color: #166534;
    }
    .status-inactive {
        background: #fef2f2;
        color: #dc2626;
    }
    .status-leave {
        background: #fef3c7;
        color: #d97706;
    }
    .registration-status {
        padding: 15px;
        border-radius: 8px;
        margin: 20px 0;
    }
    .registration-complete {
        background: #dcfce7;
        color: #166534;
        border: 2px solid #bbf7d0;
    }
    .registration-pending {
        background: #fef3c7;
        color: #d97706;
        border: 2px solid #fed7aa;
    }
    .action-buttons .btn {
        margin: 0 5px;
        border-radius: 8px;
        font-weight: 600;
    }
</style>

<div class="container-fluid">
    <!-- Employee Header -->
    <div class="employee-header">
        <div class="row align-items-center">
            <div class="col-md-2 text-center">
                @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                {
                    <img src="@Model.ProfileImagePath" alt="@Model.FullName" class="profile-image">
                }
                else
                {
                    <div class="profile-image d-flex align-items-center justify-content-center bg-white text-primary" style="font-size: 2.5rem; font-weight: bold;">
                        @(Model.FirstName.FirstOrDefault())@(Model.LastName.FirstOrDefault())
                    </div>
                }
            </div>
            <div class="col-md-7">
                <h2 class="mb-2">@Model.FullName</h2>
                <div class="employee-code mb-2">@Model.EmployeeCode</div>
                <p class="mb-1"><i class="fas fa-briefcase me-2"></i>@Model.Position</p>
                <p class="mb-0"><i class="fas fa-building me-2"></i>@Model.Department</p>
            </div>
            <div class="col-md-3 text-end">
                <div class="mb-3">
                    <span class="status-badge @(Model.Status.ToLower() switch 
                                              {
                                                  "active" => "status-active",
                                                  "inactive" => "status-inactive", 
                                                  _ => "status-leave"
                                              })">
                        @Model.Status
                    </span>
                </div>
                <div class="action-buttons">
                    <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-light">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-light">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Registration Status -->
    <div class="registration-status @(Model.IsRegistrationComplete ? "registration-complete" : "registration-pending")">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h6 class="mb-1">
                    <i class="fas @(Model.IsRegistrationComplete ? "fa-check-circle" : "fa-clock") me-2"></i>
                    Registration Status
                </h6>
                <p class="mb-0">
                    @if (Model.IsRegistrationComplete)
                    {
                        <span>Employee has completed their registration and can access the HRMS system.</span>
                    }
                    else
                    {
                        <span>Employee registration is pending. Registration link expires on @Model.RegistrationTokenExpiry?.ToString("MMM dd, yyyy").</span>
                    }
                </p>
            </div>
            <div class="col-md-4 text-end">
                @if (!Model.IsRegistrationComplete)
                {
                    <button class="btn btn-warning" onclick="resendRegistration(@Model.EmployeeId)">
                        <i class="fas fa-paper-plane"></i> Resend Registration Email
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Personal Information -->
        <div class="col-lg-6">
            <div class="info-card">
                <h5><i class="fas fa-user me-2 text-primary"></i>Personal Information</h5>
                <div class="info-row">
                    <span class="info-label">First Name</span>
                    <span class="info-value">@Model.FirstName</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Last Name</span>
                    <span class="info-value">@Model.LastName</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Email</span>
                    <span class="info-value">
                        <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Phone</span>
                    <span class="info-value">
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <a href="tel:@Model.Phone" class="text-decoration-none">@Model.Phone</a>
                        }
                        else
                        {
                            <span class="text-muted">Not provided</span>
                        }
                    </span>
                </div>
                @if (Model.IsRegistrationComplete)
                {
                    <div class="info-row">
                        <span class="info-label">Date of Birth</span>
                        <span class="info-value">
                            @(Model.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "Not provided")
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Gender</span>
                        <span class="info-value">@(Model.Gender ?? "Not provided")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Nationality</span>
                        <span class="info-value">@(Model.Nationality ?? "Not provided")</span>
                    </div>
                }
            </div>

            @if (Model.IsRegistrationComplete && (!string.IsNullOrEmpty(Model.Address) || !string.IsNullOrEmpty(Model.EmergencyContactName)))
            {
                <!-- Contact Information -->
                <div class="info-card">
                    <h5><i class="fas fa-address-card me-2 text-primary"></i>Contact Information</h5>
                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        <div class="info-row">
                            <span class="info-label">Address</span>
                            <span class="info-value">@Model.Address</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.EmergencyContactName))
                    {
                        <div class="info-row">
                            <span class="info-label">Emergency Contact</span>
                            <span class="info-value">@Model.EmergencyContactName</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.EmergencyContactPhone))
                    {
                        <div class="info-row">
                            <span class="info-label">Emergency Phone</span>
                            <span class="info-value">
                                <a href="tel:@Model.EmergencyContactPhone" class="text-decoration-none">@Model.EmergencyContactPhone</a>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Employment Information -->
        <div class="col-lg-6">
            <div class="info-card">
                <h5><i class="fas fa-briefcase me-2 text-primary"></i>Employment Information</h5>
                <div class="info-row">
                    <span class="info-label">Employee Code</span>
                    <span class="info-value">
                        <code style="background: #f3f4f6; padding: 4px 8px; border-radius: 4px; font-weight: bold;">@Model.EmployeeCode</code>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Department</span>
                    <span class="info-value">
                        <span class="badge bg-light text-dark">@Model.Department</span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Position</span>
                    <span class="info-value">@Model.Position</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Hire Date</span>
                    <span class="info-value">@Model.HireDate.ToString("MMMM dd, yyyy")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Annual Salary</span>
                    <span class="info-value">
                        <strong class="text-success">?@Model.Salary.ToString("N0")</strong>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Employment Status</span>
                    <span class="info-value">
                        <span class="status-badge @(Model.Status.ToLower() switch 
                                                  {
                                                      "active" => "status-active",
                                                      "inactive" => "status-inactive", 
                                                      _ => "status-leave"
                                                  })">
                            @Model.Status
                        </span>
                    </span>
                </div>
            </div>

            <!-- System Information -->
            <div class="info-card">
                <h5><i class="fas fa-cog me-2 text-primary"></i>System Information</h5>
                <div class="info-row">
                    <span class="info-label">Created Date</span>
                    <span class="info-value">@Model.CreatedDate.ToString("MMMM dd, yyyy HH:mm")</span>
                </div>
                @if (Model.ModifiedDate.HasValue)
                {
                    <div class="info-row">
                        <span class="info-label">Last Modified</span>
                        <span class="info-value">@Model.ModifiedDate.Value.ToString("MMMM dd, yyyy HH:mm")</span>
                    </div>
                }
                <div class="info-row">
                    <span class="info-label">Registration Status</span>
                    <span class="info-value">
                        @if (Model.IsRegistrationComplete)
                        {
                            <span class="badge bg-success">
                                <i class="fas fa-check-circle"></i> Complete
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning">
                                <i class="fas fa-clock"></i> Pending
                            </span>
                        }
                    </span>
                </div>
                @if (!Model.IsRegistrationComplete && Model.RegistrationTokenExpiry.HasValue)
                {
                    <div class="info-row">
                        <span class="info-label">Registration Expires</span>
                        <span class="info-value">
                            @if (Model.RegistrationTokenExpiry.Value < DateTime.Now)
                            {
                                <span class="text-danger">
                                    <i class="fas fa-exclamation-triangle"></i> Expired
                                </span>
                            }
                            else
                            {
                                <span>@Model.RegistrationTokenExpiry.Value.ToString("MMM dd, yyyy")</span>
                            }
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Edit Employee
                </a>
                @if (!Model.IsRegistrationComplete)
                {
                    <button class="btn btn-warning" onclick="resendRegistration(@Model.EmployeeId)">
                        <i class="fas fa-paper-plane"></i> Resend Registration
                    </button>
                }
                <button class="btn btn-info" onclick="printDetails()">
                    <i class="fas fa-print"></i> Print Details
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Employee List
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function resendRegistration(employeeId) {
            Swal.fire({
                title: 'Resend Registration Email?',
                text: 'This will generate a new registration link and send it to the employee.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#f59e0b',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, send email',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Employee/ResendRegistrationEmail/${employeeId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: 'Email Sent!',
                                text: data.message,
                                icon: 'success',
                                confirmButtonColor: '#22c55e'
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire({
                                title: 'Error!',
                                text: data.message,
                                icon: 'error',
                                confirmButtonColor: '#ef4444'
                            });
                        }
                    })
                    .catch(error => {
                        Swal.fire({
                            title: 'Error!',
                            text: 'An error occurred while sending the email.',
                            icon: 'error',
                            confirmButtonColor: '#ef4444'
                        });
                    });
                }
            });
        }

        function printDetails() {
            window.print();
        }

        // Print styles
        const style = document.createElement('style');
        style.textContent = `
            @@media print {
                .action-buttons, .btn { display: none !important; }
                .employee-header { background: #6366f1 !important; -webkit-print-color-adjust: exact; }
                .info-card { break-inside: avoid; }
                body { font-size: 12px; }
            }
        `;
        document.head.appendChild(style);
    </script>
}

@section Styles {
    <style>
        @@media print {
            .action-buttons, .btn { display: none !important; }
            .employee-header { background: #6366f1 !important; -webkit-print-color-adjust: exact; }
            .info-card { break-inside: avoid; page-break-inside: avoid; }
            body { font-size: 12px; }
            .container-fluid { margin: 0; padding: 0; }
        }
    </style>
}