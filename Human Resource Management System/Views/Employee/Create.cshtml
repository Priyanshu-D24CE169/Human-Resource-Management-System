@model EmployeeViewModel
@{
    ViewData["Title"] = "Add New Employee";
}

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-user-plus"></i> Add New Employee</h5>
                <small class="text-light">Employee will receive an email with registration instructions</small>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(TempData["Success"] as string))
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(TempData["Warning"] as string))
                {
                    <div class="alert alert-warning alert-dismissible fade show">
                        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Warning"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(TempData["Error"] as string))
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                
                <!-- Employee Code Preview -->
                <div class="alert alert-info">
                    <h6><i class="fas fa-id-card me-2"></i>Employee Code Preview</h6>
                    <p class="mb-1">Employee Code will be auto-generated in format: <strong>OI[FirstName][LastName][Year][Serial]</strong></p>
                    <p class="mb-0">Example: <code>OIJODO20250001</code> (John Doe, hired in 2025, serial 0001)</p>
                </div>

                <form asp-action="Create" method="post">
                    <div class="row">
                        <!-- Personal Information -->
                        <div class="col-md-6">
                            <h6 class="text-primary mb-3"><i class="fas fa-user me-2"></i>Personal Information</h6>
                            
                            <div class="mb-3">
                                <label asp-for="FirstName" class="form-label">First Name</label>
                                <input asp-for="FirstName" class="form-control" placeholder="John" required />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="LastName" class="form-label">Last Name</label>
                                <input asp-for="LastName" class="form-control" placeholder="Doe" required />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">Email Address</label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="john.doe@company.com" required />
                                <small class="text-muted">Registration link will be sent to this email</small>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label">Phone Number (Optional)</label>
                                <input asp-for="Phone" class="form-control" type="tel" placeholder="+91 9876543210" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <!-- Job Information -->
                        <div class="col-md-6">
                            <h6 class="text-primary mb-3"><i class="fas fa-briefcase me-2"></i>Job Information</h6>
                            
                            <div class="mb-3">
                                <label asp-for="Department" class="form-label">Department</label>
                                <select asp-for="Department" class="form-select" required>
                                    <option value="">Select Department</option>
                                    <option value="IT">Information Technology</option>
                                    <option value="HR">Human Resources</option>
                                    <option value="Finance">Finance</option>
                                    <option value="Sales">Sales</option>
                                    <option value="Marketing">Marketing</option>
                                    <option value="Operations">Operations</option>
                                    <option value="Legal">Legal</option>
                                    <option value="Admin">Administration</option>
                                </select>
                                <span asp-validation-for="Department" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Position" class="form-label">Position</label>
                                <input asp-for="Position" class="form-control" placeholder="Software Developer" required />
                                <span asp-validation-for="Position" class="text-danger"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="HireDate" class="form-label">Join Date</label>
                                <input asp-for="HireDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="HireDate" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Salary" class="form-label">Annual Salary (?)</label>
                                <input asp-for="Salary" class="form-control" type="number" step="1000" min="0" placeholder="750000" required />
                                <small class="text-muted">Enter annual salary in Indian Rupees</small>
                                <span asp-validation-for="Salary" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Active" selected>Active</option>
                                    <option value="On Leave">On Leave</option>
                                    <option value="Inactive">Inactive</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Email Notification Info -->
                    <div class="alert alert-light border">
                        <h6><i class="fas fa-envelope me-2"></i>What happens after creating the employee?</h6>
                        <ul class="mb-0 small">
                            <li>Employee receives a welcome email with registration instructions</li>
                            <li>Registration link is valid for 7 days</li>
                            <li>Employee can complete their profile and set password</li>
                            <li>Once registered, they can login to the HRMS system</li>
                        </ul>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-paper-plane"></i> Create Employee & Send Email
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Auto-generate employee code preview
    document.addEventListener('DOMContentLoaded', function() {
        const firstNameInput = document.querySelector('input[name="FirstName"]');
        const lastNameInput = document.querySelector('input[name="LastName"]');
        const hireDateInput = document.querySelector('input[name="HireDate"]');
        
        function updateEmployeeCodePreview() {
            const firstName = firstNameInput.value || 'John';
            const lastName = lastNameInput.value || 'Doe';
            const hireDate = new Date(hireDateInput.value || Date.now());
            
            const firstInitials = firstName.length >= 2 ? firstName.substring(0, 2).toUpperCase() : firstName.toUpperCase().padEnd(2, 'X');
            const lastInitials = lastName.length >= 2 ? lastName.substring(0, 2).toUpperCase() : lastName.toUpperCase().padEnd(2, 'X');
            const year = hireDate.getFullYear();
            
            const previewCode = `OI${firstInitials}${lastInitials}${year}0001`;
            
            // Update preview in the info box
            const example = document.querySelector('.alert-info code');
            if (example) {
                example.textContent = previewCode;
            }
        }
        
        firstNameInput.addEventListener('input', updateEmployeeCodePreview);
        lastNameInput.addEventListener('input', updateEmployeeCodePreview);
        hireDateInput.addEventListener('change', updateEmployeeCodePreview);
        
        // Initial update
        updateEmployeeCodePreview();
    });
</script>