@model Human_Resource_Management_System.Models.UserRegistrationConfirmationViewModel
@{
    ViewData["Title"] = "Registration Successful";
    Layout = null; // Standalone page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Odoo India HRMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .confirmation-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .confirmation-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
            max-width: 700px;
            width: 100%;
            animation: slideUp 0.6s ease-out;
        }
        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .confirmation-header {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            text-align: center;
            padding: 40px 30px;
        }
        .confirmation-header .success-icon {
            font-size: 4rem;
            margin-bottom: 20px;
            animation: bounce 1s ease-in-out;
        }
        @@keyframes bounce {
            0%, 20%, 50%, 80%, 100% {
                transform: translateY(0);
            }
            40% {
                transform: translateY(-20px);
            }
            60% {
                transform: translateY(-10px);
            }
        }
        .confirmation-header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            font-weight: 700;
        }
        .confirmation-body {
            padding: 40px;
        }
        .employee-code-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 15px;
            text-align: center;
            margin-bottom: 30px;
        }
        .employee-code {
            font-size: 2rem;
            font-weight: bold;
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
            margin-bottom: 10px;
        }
        .details-section {
            background: #f8f9fa;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 25px;
            border-left: 5px solid #28a745;
        }
        .details-section h4 {
            color: #333;
            margin-bottom: 20px;
            font-weight: 600;
            display: flex;
            align-items: center;
        }
        .details-section h4 i {
            margin-right: 10px;
            color: #28a745;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #e9ecef;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            font-weight: 600;
            color: #555;
            flex: 0 0 40%;
        }
        .detail-value {
            color: #333;
            flex: 1;
            text-align: right;
        }
        .next-steps {
            background: #e8f5e8;
            padding: 25px;
            border-radius: 15px;
            margin: 25px 0;
        }
        .next-steps h4 {
            color: #155724;
            margin-bottom: 15px;
        }
        .next-steps ul {
            margin-bottom: 0;
        }
        .next-steps li {
            margin-bottom: 8px;
            color: #155724;
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 15px 30px;
            font-size: 1.1rem;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-success {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            border: none;
            padding: 15px 30px;
            font-size: 1.1rem;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }
        .status-badge {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }
        .status-active {
            background: #d4edda;
            color: #155724;
        }
        .email-confirmation {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 10px;
            padding: 15px;
            margin: 20px 0;
        }
        .email-confirmation .alert-heading {
            color: #856404;
            font-weight: 600;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="confirmation-container">
        <div class="confirmation-card">
            <div class="confirmation-header">
                <div class="success-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h1>Registration Successful!</h1>
                <p style="font-size: 1.2rem; margin: 0; opacity: 0.9;">Welcome to Odoo India HRMS</p>
            </div>

            <div class="confirmation-body">
                <!-- Employee Code Display -->
                <div class="employee-code-card">
                    <h3 style="margin-bottom: 10px; font-weight: 300;">Your Employee Code</h3>
                    <div class="employee-code">@Model.EmployeeCode</div>
                    <small style="opacity: 0.9;">Please save this code for future reference</small>
                </div>

                <!-- Personal Information -->
                <div class="details-section">
                    <h4><i class="fas fa-user"></i> Personal Information</h4>
                    <div class="detail-row">
                        <span class="detail-label">Full Name:</span>
                        <span class="detail-value">@Model.FirstName @Model.LastName</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Email:</span>
                        <span class="detail-value">@Model.Email</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Phone:</span>
                        <span class="detail-value">@Model.Phone</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Address:</span>
                        <span class="detail-value">@Model.FullAddress</span>
                    </div>
                </div>

                <!-- Employment Information -->
                <div class="details-section">
                    <h4><i class="fas fa-briefcase"></i> Employment Details</h4>
                    <div class="detail-row">
                        <span class="detail-label">Department:</span>
                        <span class="detail-value">@Model.Department</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Position:</span>
                        <span class="detail-value">@Model.Position</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Hire Date:</span>
                        <span class="detail-value">@Model.HireDate.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Annual Salary:</span>
                        <span class="detail-value">?@Model.Salary.ToString("N0")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Status:</span>
                        <span class="detail-value">
                            <span class="status-badge status-active">@Model.Status</span>
                        </span>
                    </div>
                </div>

                <!-- Registration Information -->
                <div class="details-section">
                    <h4><i class="fas fa-calendar-check"></i> Registration Details</h4>
                    <div class="detail-row">
                        <span class="detail-label">Registration Date:</span>
                        <span class="detail-value">@Model.RegistrationDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">User ID:</span>
                        <span class="detail-value">#@Model.UserId</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Email Status:</span>
                        <span class="detail-value">
                            @if (Model.EmailConfirmed)
                            {
                                <span class="text-success"><i class="fas fa-check-circle"></i> Confirmed</span>
                            }
                            else
                            {
                                <span class="text-warning"><i class="fas fa-clock"></i> Pending Verification</span>
                            }
                        </span>
                    </div>
                </div>

                <!-- Email Confirmation Notice -->
                <div class="email-confirmation">
                    <div class="alert-heading">
                        <i class="fas fa-envelope"></i> Email Confirmation Sent
                    </div>
                    <p class="mb-0">
                        A detailed welcome email with your complete registration information has been sent to <strong>@Model.Email</strong>. 
                        Please check your inbox (and spam folder) for the confirmation email.
                    </p>
                </div>

                <!-- Next Steps -->
                <div class="next-steps">
                    <h4><i class="fas fa-list-check"></i> What's Next?</h4>
                    <ul>
                        <li><strong>Login Access:</strong> You can now login to the HRMS system using your email and password</li>
                        <li><strong>Complete Profile:</strong> Add any additional information in your employee dashboard</li>
                        <li><strong>System Orientation:</strong> Familiarize yourself with the HRMS features and tools</li>
                        <li><strong>Contact HR:</strong> Reach out if you need assistance or have questions</li>
                        <li><strong>Save Information:</strong> Keep your Employee Code (@Model.EmployeeCode) for future reference</li>
                    </ul>
                </div>

                <!-- Action Buttons -->
                <div class="text-center mt-4">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="/Login" class="btn btn-success me-md-2">
                            <i class="fas fa-sign-in-alt"></i> Login to HRMS
                        </a>
                        <button onclick="window.print()" class="btn btn-primary">
                            <i class="fas fa-print"></i> Print Confirmation
                        </button>
                    </div>
                </div>

                <!-- Additional Information -->
                <div class="text-center mt-4">
                    <small class="text-muted">
                        Registration completed successfully on @DateTime.Now.ToString("MMMM dd, yyyy") at @DateTime.Now.ToString("hh:mm tt")
                        <br>
                        For support, contact: <a href="mailto:hr@odooinda.com">hr@odooinda.com</a> | Phone: +91-1234567890
                    </small>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Auto-print option for record keeping
        $(document).ready(function() {
            // Optional: Auto-redirect to login after 30 seconds
            // setTimeout(function() {
            //     if (confirm('Would you like to proceed to login?')) {
            //         window.location.href = '/Login';
            //     }
            // }, 30000);

            // Celebration animation
            setTimeout(function() {
                if (typeof confetti !== 'undefined') {
                    confetti({
                        particleCount: 100,
                        spread: 70,
                        origin: { y: 0.6 }
                    });
                }
            }, 1000);
        });

        // Print functionality
        function printConfirmation() {
            window.print();
        }
    </script>
</body>
</html>