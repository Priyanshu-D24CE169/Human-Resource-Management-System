@model List<AttendanceViewModel>
@{
    ViewData["Title"] = "Attendance Management";
}

<style>
    .attendance-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .status-present { background: #d4edda; color: #155724; }
    .status-absent { background: #f8d7da; color: #721c24; }
    .status-leave { background: #fff3cd; color: #856404; }
    .time-badge {
        background: #e9ecef;
        padding: 4px 8px;
        border-radius: 8px;
        font-family: monospace;
        font-weight: bold;
    }
</style>

<div class="row mb-4">
    <div class="col-md-6">
        <h2 class="mb-0">Attendance Management</h2>
        <p class="text-muted">Track employee attendance and working hours</p>
    </div>
    <div class="col-md-6 text-end">
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#markAttendanceModal">
            <i class="fas fa-plus"></i> Mark Attendance
        </button>
        <button class="btn btn-primary">
            <i class="fas fa-download"></i> Export Report
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <h4>@Model.Count(a => a.Status == "Present")</h4>
                <p class="mb-0">Present Today</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-danger text-white">
            <div class="card-body text-center">
                <h4>@Model.Count(a => a.Status == "Absent")</h4>
                <p class="mb-0">Absent Today</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <h4>@Model.Count(a => a.Status == "Leave")</h4>
                <p class="mb-0">On Leave</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <h4>@Model.Where(a => a.Status == "Present").Average(a => (double?)a.WorkingHours)?.ToString("F1") ?? "0"</h4>
                <p class="mb-0">Avg. Hours</p>
            </div>
        </div>
    </div>
</div>

<!-- Date Filter -->
<div class="row mb-4">
    <div class="col-md-4">
        <label class="form-label">Select Date</label>
        <input type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" id="dateFilter">
    </div>
    <div class="col-md-4">
        <label class="form-label">Department</label>
        <select class="form-select" id="departmentFilter">
            <option value="">All Departments</option>
            <option value="IT">IT</option>
            <option value="HR">HR</option>
            <option value="Finance">Finance</option>
            <option value="Sales">Sales</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Status</label>
        <select class="form-select" id="statusFilter">
            <option value="">All Status</option>
            <option value="Present">Present</option>
            <option value="Absent">Absent</option>
            <option value="Leave">On Leave</option>
        </select>
    </div>
</div>

<!-- Attendance Table -->
<div class="attendance-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Employee</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Working Hours</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; font-size: 0.8rem;">
                                    @record.EmployeeName.Split(' ').Select(n => n[0]).Take(2).Aggregate("", (acc, c) => acc + c)
                                </div>
                                <div>
                                    <div class="fw-bold">@record.EmployeeName</div>
                                    <small class="text-muted">@record.EmployeeId</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (record.Status == "Present")
                            {
                                <span class="time-badge">@record.CheckIn.ToString(@"hh\:mm")</span>
                            }
                            else
                            {
                                <span class="text-muted">--:--</span>
                            }
                        </td>
                        <td>
                            @if (record.Status == "Present" && record.CheckOut != TimeSpan.Zero)
                            {
                                <span class="time-badge">@record.CheckOut.ToString(@"hh\:mm")</span>
                            }
                            else if (record.Status == "Present")
                            {
                                <span class="text-warning">Not checked out</span>
                            }
                            else
                            {
                                <span class="text-muted">--:--</span>
                            }
                        </td>
                        <td>
                            @if (record.WorkingHours > 0)
                            {
                                <span class="fw-bold">@record.WorkingHours.ToString("F1")h</span>
                            }
                            else
                            {
                                <span class="text-muted">0h</span>
                            }
                        </td>
                        <td>
                            <span class="badge status-@record.Status.ToLower().Replace(" ", "")">
                                @record.Status
                            </span>
                        </td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    Actions
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-edit"></i> Edit</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-eye"></i> View Details</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-clock"></i> Time Logs</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Mark Attendance Modal -->
<div class="modal fade" id="markAttendanceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Mark Attendance</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Employee</label>
                        <select class="form-select">
                            <option>Select Employee</option>
                            @foreach (var record in Model)
                            {
                                <option value="@record.EmployeeId">@record.EmployeeName (@record.EmployeeId)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label">Check In Time</label>
                            <input type="time" class="form-control">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Check Out Time</label>
                            <input type="time" class="form-control">
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <label class="form-label">Status</label>
                        <select class="form-select">
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="Leave">On Leave</option>
                            <option value="Half Day">Half Day</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Save Attendance</button>
            </div>
        </div>
    </div>
</div>