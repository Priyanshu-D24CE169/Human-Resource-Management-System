@model List<AttendanceViewModel>
@{
    ViewData["Title"] = "Attendance Management";
    var selectedDate = (DateTime)ViewBag.SelectedDate;
    var summary = ViewBag.Summary as Human_Resource_Management_System.Services.AttendanceSummary;
    var employees = ViewBag.Employees as List<Human_Resource_Management_System.Models.Employee>;
    var departmentFilter = ViewBag.DepartmentFilter as string ?? "";
    var statusFilter = ViewBag.StatusFilter as string ?? "";
}

<style>
    .attendance-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .status-present { background: #d4edda; color: #155724; }
    .status-absent { background: #f8d7da; color: #721c24; }
    .status-leave { background: #fff3cd; color: #856404; }
    .status-halfday, .status-half-day { background: #cce5ff; color: #004085; }
    .status-notmarked, .status-not-marked { background: #e2e3e5; color: #383d41; }
    .time-badge {
        background: #e9ecef;
        padding: 4px 8px;
        border-radius: 8px;
        font-family: monospace;
        font-weight: bold;
    }
    .summary-card {
        border-radius: 10px;
        transition: transform 0.2s;
    }
    .summary-card:hover {
        transform: translateY(-3px);
    }
</style>

<div class="row mb-4">
    <div class="col-md-6">
        <h2 class="mb-0"><i class="fas fa-clock me-2"></i>Attendance Management</h2>
        <p class="text-muted">Track employee attendance and working hours</p>
    </div>
    <div class="col-md-6 text-end">
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#markAttendanceModal">
            <i class="fas fa-plus"></i> Mark Attendance
        </button>
        <a href="@Url.Action("ExportReport", "Attendance", new { startDate = selectedDate.AddMonths(-1).ToString("yyyy-MM-dd"), endDate = selectedDate.ToString("yyyy-MM-dd") })" class="btn btn-primary">
            <i class="fas fa-download"></i> Export Report
        </a>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card summary-card bg-success text-white">
            <div class="card-body text-center">
                <h4 id="presentCount">@(summary?.PresentCount ?? 0)</h4>
                <p class="mb-0"><i class="fas fa-check-circle me-1"></i>Present Today</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card summary-card bg-danger text-white">
            <div class="card-body text-center">
                <h4 id="absentCount">@(summary?.AbsentCount ?? 0)</h4>
                <p class="mb-0"><i class="fas fa-times-circle me-1"></i>Absent Today</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card summary-card bg-warning text-white">
            <div class="card-body text-center">
                <h4 id="leaveCount">@(summary?.OnLeaveCount ?? 0)</h4>
                <p class="mb-0"><i class="fas fa-calendar-times me-1"></i>On Leave</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card summary-card bg-info text-white">
            <div class="card-body text-center">
                <h4 id="avgHours">@(summary?.AverageWorkingHours.ToString("F1") ?? "0")</h4>
                <p class="mb-0"><i class="fas fa-hourglass-half me-1"></i>Avg. Hours</p>
            </div>
        </div>
    </div>
</div>

<!-- Date Filter -->
<div class="row mb-4">
    <div class="col-md-4">
        <label class="form-label">Select Date</label>
        <input type="date" class="form-control" value="@selectedDate.ToString("yyyy-MM-dd")" id="dateFilter" onchange="filterAttendance()">
    </div>
    <div class="col-md-4">
        <label class="form-label">Department</label>
        <select class="form-select" id="departmentFilter" onchange="filterAttendance()">
            <option value="">All Departments</option>
            <option value="IT">Information Technology</option>
            <option value="HR">Human Resources</option>
            <option value="Finance">Finance</option>
            <option value="Sales">Sales</option>
            <option value="Marketing">Marketing</option>
            <option value="Operations">Operations</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Status</label>
        <select class="form-select" id="statusFilter" onchange="filterAttendance()">
            <option value="">All Status</option>
            <option value="Present">Present</option>
            <option value="Absent">Absent</option>
            <option value="Leave">On Leave</option>
            <option value="Half Day">Half Day</option>
            <option value="Not Marked">Not Marked</option>
        </select>
    </div>
</div>

<!-- Attendance Table -->
<div class="attendance-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Working Hours</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var record in Model)
                    {
                        var statusClass = record.Status.ToLower().Replace(" ", "");
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; font-size: 0.8rem;">
                                        @record.EmployeeName.Split(' ').Select(n => n.FirstOrDefault()).Take(2).Aggregate("", (acc, c) => acc + c)
                                    </div>
                                    <div>
                                        <div class="fw-bold">@record.EmployeeName</div>
                                        <small class="text-muted">@record.EmployeeCode</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">@record.Department</span>
                            </td>
                            <td>
                                @if (record.Status == "Present" || record.Status == "Half Day")
                                {
                                    <span class="time-badge">@(record.CheckIn == TimeSpan.Zero ? "--:--" : record.CheckIn.ToString(@"hh\:mm"))</span>
                                }
                                else
                                {
                                    <span class="text-muted">--:--</span>
                                }
                            </td>
                            <td>
                                @if (record.Status == "Present" || record.Status == "Half Day")
                                {
                                    @if (record.CheckOut != TimeSpan.Zero)
                                    {
                                        <span class="time-badge">@record.CheckOut.ToString(@"hh\:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning"><i class="fas fa-exclamation-triangle"></i> Not checked out</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">--:--</span>
                                }
                            </td>
                            <td>
                                @if (record.WorkingHours > 0)
                                {
                                    <span class="fw-bold @(record.WorkingHours >= 8 ? "text-success" : record.WorkingHours >= 4 ? "text-warning" : "text-danger")">
                                        @record.WorkingHours.ToString("F1")h
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">0h</span>
                                }
                            </td>
                            <td>
                                <span class="badge status-@statusClass">
                                    @record.Status
                                </span>
                            </td>
                            <td>
                                <div class="btn-group">
                                    @if (record.AttendanceId > 0)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" onclick="editAttendance(@record.AttendanceId)" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-info" onclick="viewTimeLogs(@record.EmployeeId, '@record.EmployeeName')" title="Time Logs">
                                            <i class="fas fa-history"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteAttendance(@record.AttendanceId)" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success" onclick="quickMark(@record.EmployeeId, '@record.EmployeeName')" title="Mark Attendance">
                                            <i class="fas fa-plus"></i> Mark
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No attendance records found for this date.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Mark Attendance Modal -->
<div class="modal fade" id="markAttendanceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-plus-circle me-2"></i>Mark Attendance</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="markAttendanceForm">
                    <div class="mb-3">
                        <label class="form-label">Employee <span class="text-danger">*</span></label>
                        <select class="form-select" id="markEmployeeId" required>
                            <option value="">Select Employee</option>
                            @if (employees != null)
                            {
                                @foreach (var emp in employees)
                                {
                                    <option value="@emp.EmployeeId">@emp.FullName (@emp.EmployeeCode)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="markDate" value="@selectedDate.ToString("yyyy-MM-dd")" required>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label">Check In Time</label>
                            <input type="time" class="form-control" id="markCheckIn" value="09:00">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Check Out Time</label>
                            <input type="time" class="form-control" id="markCheckOut" value="18:00">
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <select class="form-select" id="markStatus" required onchange="toggleTimeFields()">
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="Leave">On Leave</option>
                            <option value="Half Day">Half Day</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" id="markNotes" rows="2" placeholder="Optional notes..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="saveAttendance()">
                    <i class="fas fa-save me-1"></i>Save Attendance
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Attendance Modal -->
<div class="modal fade" id="editAttendanceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Edit Attendance</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editAttendanceForm">
                    <input type="hidden" id="editAttendanceId">
                    <div class="mb-3">
                        <label class="form-label">Employee</label>
                        <input type="text" class="form-control" id="editEmployeeName" readonly style="background-color: #e9ecef;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input type="text" class="form-control" id="editDate" readonly style="background-color: #e9ecef;">
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label">Check In Time</label>
                            <input type="time" class="form-control" id="editCheckIn">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Check Out Time</label>
                            <input type="time" class="form-control" id="editCheckOut">
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <select class="form-select" id="editStatus" required>
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="Leave">On Leave</option>
                            <option value="Half Day">Half Day</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" id="editNotes" rows="2" placeholder="Optional notes..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updateAttendance()">
                    <i class="fas fa-save me-1"></i>Update Attendance
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Time Logs Modal -->
<div class="modal fade" id="timeLogsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-history me-2"></i>Attendance History - <span id="timeLogsEmployeeName"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="timeLogsContent">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden fields to pass filter values to JavaScript -->
<input type="hidden" id="currentDepartmentFilter" value="@departmentFilter" />
<input type="hidden" id="currentStatusFilter" value="@statusFilter" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Set initial filter values on page load
        document.addEventListener('DOMContentLoaded', function() {
            var deptFilter = document.getElementById('currentDepartmentFilter').value;
            var statFilter = document.getElementById('currentStatusFilter').value;
            
            if (deptFilter) {
                document.getElementById('departmentFilter').value = deptFilter;
            }
            if (statFilter) {
                document.getElementById('statusFilter').value = statFilter;
            }
            
            toggleTimeFields();
        });

        function filterAttendance() {
            var date = document.getElementById('dateFilter').value;
            var department = document.getElementById('departmentFilter').value;
            var status = document.getElementById('statusFilter').value;
            
            var url = '@Url.Action("Index", "Attendance")' + '?date=' + date;
            if (department) url += '&department=' + encodeURIComponent(department);
            if (status) url += '&status=' + encodeURIComponent(status);
            
            window.location.href = url;
        }

        function toggleTimeFields() {
            var status = document.getElementById('markStatus').value;
            var checkInField = document.getElementById('markCheckIn');
            var checkOutField = document.getElementById('markCheckOut');
            
            if (status === 'Absent' || status === 'Leave') {
                checkInField.disabled = true;
                checkOutField.disabled = true;
                checkInField.value = '';
                checkOutField.value = '';
            } else {
                checkInField.disabled = false;
                checkOutField.disabled = false;
                if (!checkInField.value) checkInField.value = '09:00';
                if (!checkOutField.value && status === 'Present') checkOutField.value = '18:00';
            }
        }

        function quickMark(employeeId, employeeName) {
            document.getElementById('markEmployeeId').value = employeeId;
            document.getElementById('markDate').value = document.getElementById('dateFilter').value;
            document.getElementById('markStatus').value = 'Present';
            document.getElementById('markCheckIn').value = '09:00';
            document.getElementById('markCheckOut').value = '18:00';
            document.getElementById('markNotes').value = '';
            toggleTimeFields();
            new bootstrap.Modal(document.getElementById('markAttendanceModal')).show();
        }

        function saveAttendance() {
            var employeeId = document.getElementById('markEmployeeId').value;
            var date = document.getElementById('markDate').value;
            var checkIn = document.getElementById('markCheckIn').value;
            var checkOut = document.getElementById('markCheckOut').value;
            var status = document.getElementById('markStatus').value;
            var notes = document.getElementById('markNotes').value;

            if (!employeeId || !date || !status) {
                Swal.fire('Error', 'Please fill in all required fields.', 'error');
                return;
            }

            var data = {
                employeeId: parseInt(employeeId),
                date: date,
                checkIn: checkIn ? checkIn + ':00' : null,
                checkOut: checkOut ? checkOut + ':00' : null,
                status: status,
                notes: notes
            };

            fetch('/Attendance/MarkAttendance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    Swal.fire('Success', result.message, 'success').then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Error', result.message, 'error');
                }
            })
            .catch(error => {
                Swal.fire('Error', 'An error occurred while saving attendance.', 'error');
            });
        }

        function editAttendance(attendanceId) {
            fetch('/Attendance/GetAttendance/' + attendanceId)
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    document.getElementById('editAttendanceId').value = result.data.attendanceId;
                    document.getElementById('editEmployeeName').value = result.data.employeeName;
                    document.getElementById('editDate').value = result.data.date;
                    document.getElementById('editCheckIn').value = result.data.checkIn;
                    document.getElementById('editCheckOut').value = result.data.checkOut;
                    document.getElementById('editStatus').value = result.data.status;
                    document.getElementById('editNotes').value = result.data.notes || '';
                    new bootstrap.Modal(document.getElementById('editAttendanceModal')).show();
                } else {
                    Swal.fire('Error', result.message, 'error');
                }
            })
            .catch(error => {
                Swal.fire('Error', 'An error occurred while loading attendance.', 'error');
            });
        }

        function updateAttendance() {
            var data = {
                attendanceId: parseInt(document.getElementById('editAttendanceId').value),
                checkIn: document.getElementById('editCheckIn').value,
                checkOut: document.getElementById('editCheckOut').value,
                status: document.getElementById('editStatus').value,
                notes: document.getElementById('editNotes').value
            };

            fetch('/Attendance/UpdateAttendance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    Swal.fire('Success', result.message, 'success').then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Error', result.message, 'error');
                }
            })
            .catch(error => {
                Swal.fire('Error', 'An error occurred while updating attendance.', 'error');
            });
        }

        function deleteAttendance(attendanceId) {
            Swal.fire({
                title: 'Delete Attendance?',
                text: 'Are you sure you want to delete this attendance record?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Attendance/DeleteAttendance/' + attendanceId, {
                        method: 'POST'
                    })
                    .then(response => response.json())
                    .then(result => {
                        if (result.success) {
                            Swal.fire('Deleted!', result.message, 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Error', result.message, 'error');
                        }
                    })
                    .catch(error => {
                        Swal.fire('Error', 'An error occurred while deleting.', 'error');
                    });
                }
            });
        }

        function viewTimeLogs(employeeId, employeeName) {
            document.getElementById('timeLogsEmployeeName').textContent = employeeName;
            document.getElementById('timeLogsContent').innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';
            new bootstrap.Modal(document.getElementById('timeLogsModal')).show();

            fetch('/Attendance/EmployeeAttendance/' + employeeId)
            .then(response => response.json())
            .then(result => {
                if (result.success && result.data.length > 0) {
                    var html = '<div class="table-responsive"><table class="table table-sm table-striped">';
                    html += '<thead><tr><th>Date</th><th>Check In</th><th>Check Out</th><th>Hours</th><th>Status</th></tr></thead><tbody>';
                    result.data.slice(0, 30).forEach(function(record) {
                        var statusClass = record.status.toLowerCase().replace(' ', '');
                        html += '<tr>';
                        html += '<td>' + new Date(record.date).toLocaleDateString() + '</td>';
                        html += '<td>' + (record.checkIn !== '00:00:00' ? record.checkIn.substring(0, 5) : '--:--') + '</td>';
                        html += '<td>' + (record.checkOut !== '00:00:00' ? record.checkOut.substring(0, 5) : '--:--') + '</td>';
                        html += '<td>' + record.workingHours.toFixed(1) + 'h</td>';
                        html += '<td><span class="badge status-' + statusClass + '">' + record.status + '</span></td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table></div>';
                    document.getElementById('timeLogsContent').innerHTML = html;
                } else {
                    document.getElementById('timeLogsContent').innerHTML = '<p class="text-center text-muted py-4">No attendance history found.</p>';
                }
            })
            .catch(error => {
                document.getElementById('timeLogsContent').innerHTML = '<p class="text-center text-danger py-4">Error loading attendance history.</p>';
            });
        }
    </script>
}