@model List<PayrollViewModel>
@{
    ViewData["Title"] = "Payroll Management";
    var selectedYear = (int)ViewBag.SelectedYear;
    var selectedMonth = (int)ViewBag.SelectedMonth;
    var summary = ViewBag.Summary as Human_Resource_Management_System.Services.PayrollSummary;
    var employees = ViewBag.Employees as List<Human_Resource_Management_System.Models.Employee>;
    var departmentFilter = ViewBag.DepartmentFilter as string ?? "";
    var statusFilter = ViewBag.StatusFilter as string ?? "";
}

<style>
    .payroll-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .status-paid { background: #d4edda; color: #155724; }
    .status-pending { background: #fff3cd; color: #856404; }
    .status-processing { background: #cce5ff; color: #004085; }
    .salary-amount {
        font-family: monospace;
        font-weight: bold;
        color: #28a745;
    }
    .deduction-amount {
        color: #dc3545;
    }
    .summary-card {
        border-radius: 10px;
        transition: transform 0.2s;
    }
    .summary-card:hover {
        transform: translateY(-3px);
    }
    .payslip-modal .payslip-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px;
        border-radius: 10px 10px 0 0;
    }
    .payslip-modal .payslip-body {
        padding: 20px;
    }
    .payslip-modal .payslip-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #e9ecef;
    }
    .payslip-modal .payslip-total {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-top: 15px;
    }
</style>

<div class="row mb-4">
    <div class="col-md-6">
        <h2 class="mb-0"><i class="fas fa-money-check-alt me-2"></i>Payroll Management</h2>
        <p class="text-muted">Manage employee salaries and compensation</p>
    </div>
    <div class="col-md-6 text-end">
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#processPayrollModal">
            <i class="fas fa-calculator"></i> Process Payroll
        </button>
        <button class="btn btn-info" data-bs-toggle="modal" data-bs-target="#createPayrollModal">
            <i class="fas fa-plus"></i> Add Payroll
        </button>
        <a href="@Url.Action("ExportReport", "Payroll", new { year = selectedYear, month = selectedMonth })" class="btn btn-primary">
            <i class="fas fa-download"></i> Export Report
        </a>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card summary-card bg-primary text-white">
            <div class="card-body text-center">
                <h4>?@((summary?.TotalNetSalary ?? Model.Sum(p => p.NetSalary)).ToString("N0"))</h4>
                <p class="mb-0"><i class="fas fa-rupee-sign me-1"></i>Total Payroll</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card summary-card bg-success text-white">
            <div class="card-body text-center">
                <h4>@(summary?.PaidCount ?? Model.Count(p => p.Status == "Paid"))</h4>
                <p class="mb-0"><i class="fas fa-check-circle me-1"></i>Paid</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card summary-card bg-warning text-white">
            <div class="card-body text-center">
                <h4>@(summary?.PendingCount ?? Model.Count(p => p.Status == "Pending"))</h4>
                <p class="mb-0"><i class="fas fa-clock me-1"></i>Pending</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card summary-card bg-info text-white">
            <div class="card-body text-center">
                <h4>@(summary?.ProcessingCount ?? Model.Count(p => p.Status == "Processing"))</h4>
                <p class="mb-0"><i class="fas fa-spinner me-1"></i>Processing</p>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="row mb-4">
    <div class="col-md-3">
        <label class="form-label">Year</label>
        <select class="form-select" id="yearFilter" onchange="filterPayroll()">
            @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 5; y--)
            {
                <option value="@y">@y</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Month</label>
        <select class="form-select" id="monthFilter" onchange="filterPayroll()">
            <option value="1">January</option>
            <option value="2">February</option>
            <option value="3">March</option>
            <option value="4">April</option>
            <option value="5">May</option>
            <option value="6">June</option>
            <option value="7">July</option>
            <option value="8">August</option>
            <option value="9">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Department</label>
        <select class="form-select" id="departmentFilter" onchange="filterPayroll()">
            <option value="">All Departments</option>
            <option value="IT">Information Technology</option>
            <option value="HR">Human Resources</option>
            <option value="Finance">Finance</option>
            <option value="Sales">Sales</option>
            <option value="Marketing">Marketing</option>
            <option value="Operations">Operations</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select class="form-select" id="statusFilter" onchange="filterPayroll()">
            <option value="">All Status</option>
            <option value="Paid">Paid</option>
            <option value="Pending">Pending</option>
            <option value="Processing">Processing</option>
        </select>
    </div>
</div>

<!-- Payroll Table -->
<div class="payroll-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Basic Salary</th>
                    <th>Allowances</th>
                    <th>Deductions</th>
                    <th>Net Salary</th>
                    <th>Pay Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var payroll in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; font-size: 0.8rem;">
                                        @payroll.EmployeeName.Split(' ').Select(n => n.FirstOrDefault()).Take(2).Aggregate("", (acc, c) => acc + c)
                                    </div>
                                    <div>
                                        <div class="fw-bold">@payroll.EmployeeName</div>
                                        <small class="text-muted">@payroll.EmployeeCode</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">@payroll.Department</span>
                            </td>
                            <td class="salary-amount">?@payroll.BasicSalary.ToString("N0")</td>
                            <td class="text-success">+?@payroll.Allowances.ToString("N0")</td>
                            <td class="deduction-amount">-?@payroll.Deductions.ToString("N0")</td>
                            <td class="salary-amount fs-6">?@payroll.NetSalary.ToString("N0")</td>
                            <td>@payroll.PayDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge status-@payroll.Status.ToLower()">
                                    @payroll.Status
                                </span>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-info" onclick="viewPayslip(@payroll.PayrollId)" title="View Payslip">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <a href="@Url.Action("DownloadPayslip", "Payroll", new { id = payroll.PayrollId })" class="btn btn-sm btn-outline-primary" title="Download Payslip">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-warning" onclick="editPayroll(@payroll.PayrollId)" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    @if (payroll.Status == "Pending" || payroll.Status == "Processing")
                                    {
                                        <button class="btn btn-sm btn-outline-success" onclick="markAsPaid(@payroll.PayrollId)" title="Mark as Paid">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" onclick="deletePayroll(@payroll.PayrollId)" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4">
                            <i class="fas fa-money-bill-wave fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No payroll records found for this period.</p>
                            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#processPayrollModal">
                                <i class="fas fa-calculator"></i> Process Payroll
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            @if (Model.Any())
            {
                <tfoot class="table-light">
                    <tr>
                        <th colspan="2">Total (@Model.Count employees)</th>
                        <th class="salary-amount">?@Model.Sum(p => p.BasicSalary).ToString("N0")</th>
                        <th class="text-success">?@Model.Sum(p => p.Allowances).ToString("N0")</th>
                        <th class="deduction-amount">?@Model.Sum(p => p.Deductions).ToString("N0")</th>
                        <th class="salary-amount">?@Model.Sum(p => p.NetSalary).ToString("N0")</th>
                        <th colspan="3"></th>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

<!-- Process Payroll Modal -->
<div class="modal fade" id="processPayrollModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-calculator me-2"></i>Process Payroll</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="processPayrollForm">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Year <span class="text-danger">*</span></label>
                                <select class="form-select" id="processYear" required>
                                    @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 2; y--)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Month <span class="text-danger">*</span></label>
                                <select class="form-select" id="processMonth" required>
                                    <option value="1">January</option>
                                    <option value="2">February</option>
                                    <option value="3">March</option>
                                    <option value="4">April</option>
                                    <option value="5">May</option>
                                    <option value="6">June</option>
                                    <option value="7">July</option>
                                    <option value="8">August</option>
                                    <option value="9">September</option>
                                    <option value="10">October</option>
                                    <option value="11">November</option>
                                    <option value="12">December</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Pay Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="processPayDate" value="@DateTime.Today.AddDays(5).ToString("yyyy-MM-dd")" required>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department</label>
                        <select class="form-select" id="processDepartment">
                            <option value="All">All Departments</option>
                            <option value="IT">Information Technology</option>
                            <option value="HR">Human Resources</option>
                            <option value="Finance">Finance</option>
                            <option value="Sales">Sales</option>
                            <option value="Marketing">Marketing</option>
                            <option value="Operations">Operations</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" id="processNotes" rows="2" placeholder="Any special instructions or notes for this payroll run..."></textarea>
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        This will automatically calculate and create payroll for all eligible employees based on their salary, with standard allowances and deductions applied.
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="processPayroll()">
                    <i class="fas fa-calculator me-1"></i>Process Payroll
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Create Payroll Modal -->
<div class="modal fade" id="createPayrollModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-plus-circle me-2"></i>Add Payroll</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createPayrollForm">
                    <div class="mb-3">
                        <label class="form-label">Employee <span class="text-danger">*</span></label>
                        <select class="form-select" id="createEmployeeId" required onchange="loadEmployeeSalary()">
                            <option value="">Select Employee</option>
                            @if (employees != null)
                            {
                                @foreach (var emp in employees)
                                {
                                    <option value="@emp.EmployeeId" data-salary="@emp.Salary">@emp.FullName (@emp.EmployeeCode) - @emp.Department</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Year <span class="text-danger">*</span></label>
                                <select class="form-select" id="createYear" required>
                                    @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 2; y--)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Month <span class="text-danger">*</span></label>
                                <select class="form-select" id="createMonth" required>
                                    <option value="1">January</option>
                                    <option value="2">February</option>
                                    <option value="3">March</option>
                                    <option value="4">April</option>
                                    <option value="5">May</option>
                                    <option value="6">June</option>
                                    <option value="7">July</option>
                                    <option value="8">August</option>
                                    <option value="9">September</option>
                                    <option value="10">October</option>
                                    <option value="11">November</option>
                                    <option value="12">December</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Pay Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="createPayDate" required>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Basic Salary (?) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="createBasicSalary" required min="0" step="100" onchange="calculateNetSalary()">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Allowances (?)</label>
                                <input type="number" class="form-control" id="createAllowances" value="0" min="0" step="100" onchange="calculateNetSalary()">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Deductions (?)</label>
                                <input type="number" class="form-control" id="createDeductions" value="0" min="0" step="100" onchange="calculateNetSalary()">
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-success">
                        <strong>Net Salary: </strong><span id="createNetSalaryDisplay">?0</span>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info" onclick="createPayroll()">
                    <i class="fas fa-save me-1"></i>Create Payroll
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Payroll Modal -->
<div class="modal fade" id="editPayrollModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Edit Payroll</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editPayrollForm">
                    <input type="hidden" id="editPayrollId">
                    <div class="mb-3">
                        <label class="form-label">Employee</label>
                        <input type="text" class="form-control" id="editEmployeeName" readonly style="background-color: #e9ecef;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Pay Period</label>
                        <input type="text" class="form-control" id="editPayPeriod" readonly style="background-color: #e9ecef;">
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Basic Salary (?) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="editBasicSalary" required min="0" step="100" onchange="calculateEditNetSalary()">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Allowances (?)</label>
                                <input type="number" class="form-control" id="editAllowances" min="0" step="100" onchange="calculateEditNetSalary()">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Deductions (?)</label>
                                <input type="number" class="form-control" id="editDeductions" min="0" step="100" onchange="calculateEditNetSalary()">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Pay Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="editPayDate" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Status <span class="text-danger">*</span></label>
                                <select class="form-select" id="editStatus" required>
                                    <option value="Pending">Pending</option>
                                    <option value="Processing">Processing</option>
                                    <option value="Paid">Paid</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-success">
                        <strong>Net Salary: </strong><span id="editNetSalaryDisplay">?0</span>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="updatePayroll()">
                    <i class="fas fa-save me-1"></i>Update Payroll
                </button>
            </div>
        </div>
    </div>
</div>

<!-- View Payslip Modal -->
<div class="modal fade payslip-modal" id="viewPayslipModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="payslip-header text-center">
                <h4 class="mb-1">PAYSLIP</h4>
                <p class="mb-0" id="payslipPeriod"></p>
            </div>
            <div class="payslip-body">
                <div class="text-center mb-4">
                    <h5 id="payslipEmployeeName" class="mb-1"></h5>
                    <p class="text-muted mb-0"><span id="payslipEmployeeCode"></span> | <span id="payslipDepartment"></span></p>
                    <small class="text-muted" id="payslipPosition"></small>
                </div>
                
                <h6 class="border-bottom pb-2 mb-3">Earnings</h6>
                <div class="payslip-row">
                    <span>Basic Salary</span>
                    <span class="fw-bold" id="payslipBasicSalary"></span>
                </div>
                <div class="payslip-row">
                    <span>Allowances (HRA, Transport, Medical)</span>
                    <span class="fw-bold text-success" id="payslipAllowances"></span>
                </div>
                <div class="payslip-row">
                    <span><strong>Gross Salary</strong></span>
                    <span class="fw-bold" id="payslipGrossSalary"></span>
                </div>
                
                <h6 class="border-bottom pb-2 mb-3 mt-4">Deductions</h6>
                <div class="payslip-row">
                    <span>PF, Tax & Other Deductions</span>
                    <span class="fw-bold text-danger" id="payslipDeductions"></span>
                </div>
                
                <div class="payslip-total text-center">
                    <small class="text-muted">NET PAYABLE</small>
                    <h3 class="mb-0 text-success" id="payslipNetSalary"></h3>
                </div>
                
                <div class="text-center mt-3">
                    <span class="badge status-paid" id="payslipStatus"></span>
                    <p class="text-muted mt-2 mb-0"><small>Pay Date: <span id="payslipPayDate"></span></small></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="#" class="btn btn-primary" id="downloadPayslipBtn">
                    <i class="fas fa-download me-1"></i>Download
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Hidden fields for filter values -->
<input type="hidden" id="currentYear" value="@selectedYear" />
<input type="hidden" id="currentMonth" value="@selectedMonth" />
<input type="hidden" id="currentDepartmentFilter" value="@departmentFilter" />
<input type="hidden" id="currentStatusFilter" value="@statusFilter" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            var currentYear = document.getElementById('currentYear').value;
            var currentMonth = document.getElementById('currentMonth').value;
            var deptFilter = document.getElementById('currentDepartmentFilter').value;
            var statFilter = document.getElementById('currentStatusFilter').value;
            
            document.getElementById('yearFilter').value = currentYear;
            document.getElementById('monthFilter').value = currentMonth;
            if (deptFilter) document.getElementById('departmentFilter').value = deptFilter;
            if (statFilter) document.getElementById('statusFilter').value = statFilter;
            
            // Set process payroll defaults
            document.getElementById('processYear').value = currentYear;
            document.getElementById('processMonth').value = currentMonth;
            
            // Set create payroll defaults
            document.getElementById('createYear').value = currentYear;
            document.getElementById('createMonth').value = currentMonth;
            document.getElementById('createPayDate').value = new Date().toISOString().split('T')[0];
        });

        function filterPayroll() {
            var year = document.getElementById('yearFilter').value;
            var month = document.getElementById('monthFilter').value;
            var department = document.getElementById('departmentFilter').value;
            var status = document.getElementById('statusFilter').value;
            
            var url = '@Url.Action("Index", "Payroll")' + '?year=' + year + '&month=' + month;
            if (department) url += '&department=' + encodeURIComponent(department);
            if (status) url += '&status=' + encodeURIComponent(status);
            
            window.location.href = url;
        }

        function loadEmployeeSalary() {
            var select = document.getElementById('createEmployeeId');
            var selectedOption = select.options[select.selectedIndex];
            var annualSalary = parseFloat(selectedOption.getAttribute('data-salary')) || 0;
            var monthlySalary = Math.round(annualSalary / 12);
            
            document.getElementById('createBasicSalary').value = monthlySalary;
            
            // Calculate standard allowances and deductions
            var allowances = Math.round(monthlySalary * 0.40 + 2850); // HRA + Transport + Medical
            var deductions = Math.round(monthlySalary * 0.12 + 200); // PF + Professional Tax
            
            document.getElementById('createAllowances').value = allowances;
            document.getElementById('createDeductions').value = deductions;
            
            calculateNetSalary();
        }

        function calculateNetSalary() {
            var basic = parseFloat(document.getElementById('createBasicSalary').value) || 0;
            var allowances = parseFloat(document.getElementById('createAllowances').value) || 0;
            var deductions = parseFloat(document.getElementById('createDeductions').value) || 0;
            var net = basic + allowances - deductions;
            document.getElementById('createNetSalaryDisplay').textContent = '?' + net.toLocaleString('en-IN');
        }

        function calculateEditNetSalary() {
            var basic = parseFloat(document.getElementById('editBasicSalary').value) || 0;
            var allowances = parseFloat(document.getElementById('editAllowances').value) || 0;
            var deductions = parseFloat(document.getElementById('editDeductions').value) || 0;
            var net = basic + allowances - deductions;
            document.getElementById('editNetSalaryDisplay').textContent = '?' + net.toLocaleString('en-IN');
        }

        function processPayroll() {
            var data = {
                year: parseInt(document.getElementById('processYear').value),
                month: parseInt(document.getElementById('processMonth').value),
                payDate: document.getElementById('processPayDate').value,
                department: document.getElementById('processDepartment').value,
                notes: document.getElementById('processNotes').value
            };

            Swal.fire({
                title: 'Process Payroll?',
                text: 'This will calculate payroll for all eligible employees.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'Yes, Process'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Payroll/ProcessPayroll', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    })
                    .then(response => response.json())
                    .then(result => {
                        if (result.success) {
                            Swal.fire('Success', result.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Error', result.message, 'error');
                        }
                    })
                    .catch(() => Swal.fire('Error', 'An error occurred.', 'error'));
                }
            });
        }

        function createPayroll() {
            var data = {
                employeeId: parseInt(document.getElementById('createEmployeeId').value),
                year: parseInt(document.getElementById('createYear').value),
                month: parseInt(document.getElementById('createMonth').value),
                basicSalary: parseFloat(document.getElementById('createBasicSalary').value),
                allowances: parseFloat(document.getElementById('createAllowances').value) || 0,
                deductions: parseFloat(document.getElementById('createDeductions').value) || 0,
                payDate: document.getElementById('createPayDate').value
            };

            if (!data.employeeId || !data.basicSalary) {
                Swal.fire('Error', 'Please fill in all required fields.', 'error');
                return;
            }

            fetch('/Payroll/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    Swal.fire('Success', result.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Error', result.message, 'error');
                }
            })
            .catch(() => Swal.fire('Error', 'An error occurred.', 'error'));
        }

        function editPayroll(payrollId) {
            fetch('/Payroll/GetPayroll/' + payrollId)
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    document.getElementById('editPayrollId').value = result.data.payrollId;
                    document.getElementById('editEmployeeName').value = result.data.employeeName + ' (' + result.data.employeeCode + ')';
                    document.getElementById('editPayPeriod').value = result.data.payPeriodStart + ' to ' + result.data.payPeriodEnd;
                    document.getElementById('editBasicSalary').value = result.data.basicSalary;
                    document.getElementById('editAllowances').value = result.data.allowances;
                    document.getElementById('editDeductions').value = result.data.deductions;
                    document.getElementById('editPayDate').value = result.data.payDate;
                    document.getElementById('editStatus').value = result.data.status;
                    calculateEditNetSalary();
                    new bootstrap.Modal(document.getElementById('editPayrollModal')).show();
                } else {
                    Swal.fire('Error', result.message, 'error');
                }
            })
            .catch(() => Swal.fire('Error', 'An error occurred.', 'error'));
        }

        function updatePayroll() {
            var data = {
                payrollId: parseInt(document.getElementById('editPayrollId').value),
                basicSalary: parseFloat(document.getElementById('editBasicSalary').value),
                allowances: parseFloat(document.getElementById('editAllowances').value) || 0,
                deductions: parseFloat(document.getElementById('editDeductions').value) || 0,
                payDate: document.getElementById('editPayDate').value,
                status: document.getElementById('editStatus').value
            };

            fetch('/Payroll/Update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    Swal.fire('Success', result.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Error', result.message, 'error');
                }
            })
            .catch(() => Swal.fire('Error', 'An error occurred.', 'error'));
        }

        function deletePayroll(payrollId) {
            Swal.fire({
                title: 'Delete Payroll?',
                text: 'Are you sure you want to delete this payroll record?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Payroll/Delete/' + payrollId, { method: 'POST' })
                    .then(response => response.json())
                    .then(result => {
                        if (result.success) {
                            Swal.fire('Deleted!', result.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Error', result.message, 'error');
                        }
                    })
                    .catch(() => Swal.fire('Error', 'An error occurred.', 'error'));
                }
            });
        }

        function markAsPaid(payrollId) {
            Swal.fire({
                title: 'Mark as Paid?',
                text: 'This will mark the payroll as paid.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'Yes, mark as paid'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Payroll/MarkAsPaid/' + payrollId, { method: 'POST' })
                    .then(response => response.json())
                    .then(result => {
                        if (result.success) {
                            Swal.fire('Success', result.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Error', result.message, 'error');
                        }
                    })
                    .catch(() => Swal.fire('Error', 'An error occurred.', 'error'));
                }
            });
        }

        function viewPayslip(payrollId) {
            fetch('/Payroll/ViewPayslip/' + payrollId)
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    var d = result.data;
                    document.getElementById('payslipPeriod').textContent = d.payPeriod;
                    document.getElementById('payslipEmployeeName').textContent = d.employeeName;
                    document.getElementById('payslipEmployeeCode').textContent = d.employeeCode;
                    document.getElementById('payslipDepartment').textContent = d.department;
                    document.getElementById('payslipPosition').textContent = d.position;
                    document.getElementById('payslipBasicSalary').textContent = '?' + d.basicSalary.toLocaleString('en-IN');
                    document.getElementById('payslipAllowances').textContent = '+?' + d.allowances.toLocaleString('en-IN');
                    document.getElementById('payslipGrossSalary').textContent = '?' + d.grossSalary.toLocaleString('en-IN');
                    document.getElementById('payslipDeductions').textContent = '-?' + d.deductions.toLocaleString('en-IN');
                    document.getElementById('payslipNetSalary').textContent = '?' + d.netSalary.toLocaleString('en-IN');
                    document.getElementById('payslipStatus').textContent = d.status;
                    document.getElementById('payslipStatus').className = 'badge status-' + d.status.toLowerCase();
                    document.getElementById('payslipPayDate').textContent = d.payDate;
                    document.getElementById('downloadPayslipBtn').href = '/Payroll/DownloadPayslip/' + payrollId;
                    new bootstrap.Modal(document.getElementById('viewPayslipModal')).show();
                } else {
                    Swal.fire('Error', result.message, 'error');
                }
            })
            .catch(() => Swal.fire('Error', 'An error occurred.', 'error'));
        }
    </script>
}