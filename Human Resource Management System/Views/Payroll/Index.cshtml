@model List<PayrollViewModel>
@{
    ViewData["Title"] = "Payroll Management";
}

<style>
    .payroll-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .status-paid { background: #d4edda; color: #155724; }
    .status-pending { background: #fff3cd; color: #856404; }
    .status-processing { background: #cce5ff; color: #004085; }
    .salary-amount {
        font-family: monospace;
        font-weight: bold;
        color: #28a745;
    }
    .deduction-amount {
        color: #dc3545;
    }
</style>

<div class="row mb-4">
    <div class="col-md-6">
        <h2 class="mb-0">Payroll Management</h2>
        <p class="text-muted">Manage employee salaries and compensation</p>
    </div>
    <div class="col-md-6 text-end">
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#processPayrollModal">
            <i class="fas fa-calculator"></i> Process Payroll
        </button>
        <button class="btn btn-primary">
            <i class="fas fa-download"></i> Export Payslips
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <h4>?@Model.Sum(p => p.NetSalary).ToString("N0")</h4>
                <p class="mb-0">Total Payroll</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <h4>@Model.Count(p => p.Status == "Paid")</h4>
                <p class="mb-0">Paid</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <h4>@Model.Count(p => p.Status == "Pending")</h4>
                <p class="mb-0">Pending</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <h4>@Model.Count(p => p.Status == "Processing")</h4>
                <p class="mb-0">Processing</p>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="row mb-4">
    <div class="col-md-4">
        <label class="form-label">Pay Period</label>
        <select class="form-select">
            <option>March 2024</option>
            <option>February 2024</option>
            <option>January 2024</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Department</label>
        <select class="form-select">
            <option>All Departments</option>
            <option>IT</option>
            <option>HR</option>
            <option>Finance</option>
            <option>Sales</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Status</label>
        <select class="form-select">
            <option>All Status</option>
            <option>Paid</option>
            <option>Pending</option>
            <option>Processing</option>
        </select>
    </div>
</div>

<!-- Payroll Table -->
<div class="payroll-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Employee</th>
                    <th>Basic Salary</th>
                    <th>Allowances</th>
                    <th>Deductions</th>
                    <th>Net Salary</th>
                    <th>Pay Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payroll in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; font-size: 0.8rem;">
                                    @payroll.EmployeeName.Split(' ').Select(n => n[0]).Take(2).Aggregate("", (acc, c) => acc + c)
                                </div>
                                <div>
                                    <div class="fw-bold">@payroll.EmployeeName</div>
                                    <small class="text-muted">@payroll.EmployeeId</small>
                                </div>
                            </div>
                        </td>
                        <td class="salary-amount">?@payroll.BasicSalary.ToString("N0")</td>
                        <td class="text-success">+?@payroll.Allowances.ToString("N0")</td>
                        <td class="deduction-amount">-?@payroll.Deductions.ToString("N0")</td>
                        <td class="salary-amount fs-6">?@payroll.NetSalary.ToString("N0")</td>
                        <td>@payroll.PayDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <span class="badge status-@payroll.Status.ToLower()">
                                @payroll.Status
                            </span>
                        </td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    Actions
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-eye"></i> View Payslip</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-download"></i> Download Payslip</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-edit"></i> Edit</a></li>
                                    @if (payroll.Status == "Pending")
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-success" href="#"><i class="fas fa-check"></i> Mark as Paid</a></li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <th>Total</th>
                    <th class="salary-amount">?@Model.Sum(p => p.BasicSalary).ToString("N0")</th>
                    <th class="text-success">?@Model.Sum(p => p.Allowances).ToString("N0")</th>
                    <th class="deduction-amount">?@Model.Sum(p => p.Deductions).ToString("N0")</th>
                    <th class="salary-amount">?@Model.Sum(p => p.NetSalary).ToString("N0")</th>
                    <th colspan="3"></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Process Payroll Modal -->
<div class="modal fade" id="processPayrollModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Process Payroll</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Pay Period</label>
                                <input type="month" class="form-control" value="2024-04">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Pay Date</label>
                                <input type="date" class="form-control" value="@DateTime.Today.AddDays(5).ToString("yyyy-MM-dd")">
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department</label>
                        <select class="form-select">
                            <option>All Departments</option>
                            <option>IT</option>
                            <option>HR</option>
                            <option>Finance</option>
                            <option>Sales</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Additional Notes</label>
                        <textarea class="form-control" rows="3" placeholder="Any special instructions or notes for this payroll run..."></textarea>
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        This will process payroll for all eligible employees in the selected department for the specified pay period.
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success">Process Payroll</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add any payroll-specific JavaScript here
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize tooltips or other interactive elements
            console.log('Payroll management page loaded');
        });
    </script>
}